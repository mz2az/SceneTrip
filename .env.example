# 로컬 개발용 비밀값. 이 파일을 .env 로 복사해 값을 채운다 — .env 는 gitignore 다.
#
#   cp .env.example .env
#
# justfile 의 dotenv-load 가 .env 를 모든 just 레시피의 환경변수로 올린다. 터미널에서
# 직접 실행하는 명령은 .env 를 모르므로 그때는 export 가 필요하다.
#
# 값은 팀 채널에서 받는다. 이 파일에는 절대 실제 값을 적지 않는다 (AGENTS.md §9).

# 네이버 지도 SDK 클라이언트 ID. iOS 앱 빌드에 주입된다 (just ios-run).
# 번들 ID 에 묶여 있어 앱에 박혀도 남이 못 쓴다.
NAVER_MAP_CLIENT_ID=

# 카카오 REST API 키. 여행 중 길찾기 — 서버가 카카오 대중교통·도보 API 를 부른다.
# `just secrets-apply` 가 이 값을 클러스터 Secret 으로 넣고, scene-api 파드가 환경변수로
# 받는다. 없어도 서버는 뜬다 — 길찾기만 503 을 낸다.
# 발급: 카카오 디벨로퍼스 → 내 애플리케이션 → 앱 키 → REST API 키
# (JavaScript 키·네이티브 키가 아니다. Authorization: KakaoAK 헤더에 들어가는 것은 REST 키뿐이다.)
KAKAO_REST_KEY=

# 로그인 액세스 토큰(JWT)의 서명 키. base64, 32 바이트 이상. 저장소 밖에서 만든다:
#   openssl rand -base64 48
# `just secrets-apply` 가 클러스터 Secret 으로 넣는다. 없어도 서버는 뜬다 — 로그인만 꺼진다.
# **바꾸면 로그인한 사람이 전부 로그아웃된다** — 옛 키로 서명된 토큰은 ACCESS_TOKEN_INVALID 가 되고,
# 앱은 그 코드에 갱신하지 않고 토큰을 지운다(계약). 한 번 정하면 그대로 둔다.
SCENETRIP_AUTH_JWT_SECRET=

# 외부 토큰(애플 refresh token) 암호화 키. base64 32 바이트, JWT 키와 따로:
#   openssl rand -base64 32
# 없으면 애플 로그인만 꺼진다.
SCENETRIP_AUTH_TOKEN_ENCRYPTION_KEY=

# 애플 로그인 개인 키 — Apple Developer 에서 받은 .p8 파일 전체를 base64 한 줄로:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
# 원본 .p8 은 저장소 밖에 둔다(다시 내려받을 수 없으니 백업). 없으면 애플 로그인만 꺼진다.
SCENETRIP_AUTH_APPLE_PRIVATE_KEY=

# Android SDK 경로. 안드로이드 빌드가 aapt2 를 찾는 데 쓴다.
ANDROID_HOME=
