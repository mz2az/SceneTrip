<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- 화면 문구를 한국어·영어로 낸다 (MZ2AZ-343). 원문(열쇠)이 한국어라 개발 지역은 ko 다.
	     선언이 없으면 시스템이 주는 문구(「결과 없음」 등)도 영어로만 나온다. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
	<!-- 구글 로그인 (MZ2AZ-336). GIDClientID 는 iOS 클라이언트 ID, URL scheme 은 그것을 뒤집은 것 —
	     로그인 뒤 구글이 이 scheme 으로 앱을 다시 연다. 둘 다 비밀이 아니다. -->
	<key>GIDClientID</key>
	<string>700188854872-7v9hphkb4phavae7stepil7q6vp7lbig.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.700188854872-7v9hphkb4phavae7stepil7q6vp7lbig</string>
			</array>
		</dict>
	</array>
	<!-- 길찾기 한도에 걸리면 그 구간을 지도 앱으로 넘긴다 (MZ2AZ-366 D). 깔려 있는지 `canOpenURL` 로 물으려면
	     스킴을 여기 적어야 한다 — 카카오맵 `kakaomap`, 네이버 지도 `nmap`(두 회사의 URL Scheme 문서). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaomap</string>
		<string>nmap</string>
	</array>
	<key>CFBundleName</key>
	<string>SceneTrip</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- 배포 빌드는 arm64 전용이라 App Store 가 요구한다 (MZ2AZ-460, 오류 90502). -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- 시스템 설정과 관계없이 밝은 화면을 유지한다 (MZ2AZ-419). -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- iPad의 iPhone 호환 모드에서도 세로 화면 비율을 유지한다 (MZ2AZ-416). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- 위치 권한 문구. iOS 는 이것이 없으면 권한을 **묻지도 않고** 바로 거부한다.
	     App Store 심사와 사용자에게 그대로 보이는 문장이므로 무엇에 쓰는지 적는다.
	     한국어·영어 문구는 번들 InfoPlist.strings에서 고른다 (MZ2AZ-416). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>가까운 촬영지·편의시설 검색, 여행 중 길 안내와 동의한 발자취 기록에 위치를 사용합니다.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>광고가 SceneTrip 설치와 앱 사용(장소 저장·코스 만들기)으로 이어졌는지 측정하는 데 사용합니다. 허용하지 않아도 모든 기능을 쓸 수 있어요.</string>
	<!-- 저장한 이용 통계 설정을 적용하기 전에는 자동 수집을 시작하지 않는다(MZ2AZ-402). -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<!-- 분석 (MZ2AZ-353). 화면 조회는 앱이 이름을 붙여 직접 보낸다(RootTabs) — Firebase 의 자동 화면 기록을
	     켜 두면 알림창·시트가 뜰 때마다 이름 없는 screen_view 가 섞여 들어온다. -->
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<!-- 메타 SDK는 설정과 ATT 허용을 확인한 뒤 직접 초기화한다 (MZ2AZ-391). -->
	<key>FacebookAutoInitEnabled</key>
	<false/>
	<key>FacebookAutoLogAppEventsEnabled</key>
	<false/>
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<false/>
</dict>
</plist>
