<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- 화면 문구를 한국어·영어로 낸다 (MZ2AZ-343). 원문(열쇠)이 한국어라 개발 지역은 ko 다.
	     선언이 없으면 시스템이 주는 문구(「결과 없음」 등)도 영어로만 나온다. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
	<!-- 구글 로그인 (MZ2AZ-336). GIDClientID 는 iOS 클라이언트 ID, URL scheme 은 그것을 뒤집은 것 —
	     로그인 뒤 구글이 이 scheme 으로 앱을 다시 연다. 둘 다 비밀이 아니다. -->
	<key>GIDClientID</key>
	<string>700188854872-7v9hphkb4phavae7stepil7q6vp7lbig.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.700188854872-7v9hphkb4phavae7stepil7q6vp7lbig</string>
			</array>
		</dict>
	</array>
	<key>CFBundleName</key>
	<string>SceneTrip</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- 위치 권한 문구. iOS 는 이것이 없으면 권한을 **묻지도 않고** 바로 거부한다.
	     App Store 심사와 사용자에게 그대로 보이는 문장이므로 무엇에 쓰는지 적는다.
	     다국어는 InfoPlist.strings 로 나중에 나눈다 (MVP1 은 한국어+영어). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>가까운 촬영지를 찾기 위해 위치를 사용합니다.</string>
	<!-- 분석 (MZ2AZ-353). 화면 조회는 앱이 이름을 붙여 직접 보낸다(RootTabs) — Firebase 의 자동 화면 기록을
	     켜 두면 알림창·시트가 뜰 때마다 이름 없는 screen_view 가 섞여 들어온다. -->
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
</dict>
</plist>
