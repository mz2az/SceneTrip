<?xml version="1.0" encoding="utf-8"?>
<!--
  bundle id 는 iOS 와 같은 com.mz2az.scenetrip 다. 스토어가 다르므로 충돌하지 않고,
  같은 제품이라는 것이 드러난다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mz2az.scenetrip">

    <!-- 지도와 서버 호출에 필요하다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      지도 SDK 가 연결 상태를 본다. **AAR 이 자기 매니페스트에 이미 선언하고 있지만
      최종 APK 로 병합되지 않아서** 여기에 직접 적는다 (aapt2 dump permissions 로
      INTERNET 하나만 남은 것을 확인).

      없으면 앱이 뜬 직후 죽는다 — 지도 SDK 가 CONNECTIVITY_CHANGE 를 받아
      getActiveNetworkInfo 를 부르는 순간 SecurityException 이 난다(실측).
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      「내 위치」 버튼 (MZ2AZ-252). iOS 는 Info.plist 의
      NSLocationWhenInUseUsageDescription 이 같은 몫을 한다.

      **둘 다 적는다.** FINE 만 적으면 Android 12 부터 사용자가 「대략적인 위치」를
      고를 수 있는데, 그때 COARSE 가 선언돼 있지 않으면 아무것도 받지 못한다.
      촬영지를 찾아 주는 앱이라 대략적인 위치로도 충분하므로 그 선택을 막지 않는다.

      런타임에 한 번 더 물어봐야 한다 — 선언만으로는 좌표가 오지 않는다.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      **평문 HTTP 를 허용한다.** Android 9 부터 기본으로 막히는데, 개발 중 서버는
      `http://10.0.2.2:8081` 이다. 막힌 상태에서는 호출이 조용히 실패해 화면이 빈
      목록으로만 보이므로 원인을 찾기 어렵다.

      스토어에 낼 때는 빼야 한다 — 그때는 서버가 HTTPS 다. 지금 빼 두면 개발이
      돌지 않으므로 남기되, 여기 적어 둔다.
    -->
    <application
        android:label="SceneTrip"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!--
          네이버 지도 클라이언트 ID. 값은 소스에 박지 않는다 — `${naverNcpKeyId}` 는
          BUILD 의 manifest_values 가 채우고, 그 값은 `.env` 에서 온다.

          **NCP_KEY_ID 다.** 지금 콘솔이 발급하는 키는 신형이라 구형 자리(CLIENT_ID)에
          넣으면 인증에 실패한다 — iOS 에서 `clientId` 에 넣었다가 타일이 한 장도 오지
          않았던 것과 같은 구분이다(SceneTripApp.swift). 두 이름 모두 SDK 3.23.3 의
          클래스 파일에 존재하는 것을 확인했다.
        -->
        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${naverNcpKeyId}" />
        <!--
          **iOS 에는 타이틀바가 없다.** 기본 테마는 앱 이름이 적힌 검은 ActionBar 를
          얹는데, 그것 하나로 두 앱이 다른 제품처럼 보인다 (ADR 0008).

          플랫폼 테마가 아니라 AppCompat 테마를 쓰는 이유: 네이버 지도의 로고
          (저작권 표시, 지도 좌하단 — SDK 약관상 뗄 수 없다) 를 누르면 SDK 내부가
          `androidx.appcompat.app.AlertDialog` 로 라이선스 팝업을 띄우는데, 그건
          호스트 Activity 가 AppCompat 테마가 아니면 `IllegalStateException: You
          need to use a Theme.AppCompat theme`로 앱 전체가 죽는다(실측, 2026-09-28
          — 상세 화면에서 지도 로고를 눌렀을 뿐인데 강제 종료됐다).
          `com.google.android.material` 없이도 되는 이유: `androidx.appcompat` 는
          이미 네이버 지도 AAR 이 전이 의존성으로 끌어와 있다(MODULE.bazel 참고) —
          새 의존성이 아니라 이미 있는 것을 테마에서도 쓰는 것뿐이다.
        -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
