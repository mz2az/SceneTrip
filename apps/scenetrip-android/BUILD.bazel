# apps/scenetrip-android 의 타깃.
#
# AGENTS.md §4.1 의 이름 규칙을 따른다 — 라벨을 예측할 수 있어야 사람도 AI 도
# 이 파일을 먼저 읽지 않고 타깃을 조립할 수 있다.
#
#   :scenetrip-android  이 모듈의 주 라이브러리 (kt_android_library)
#   :bin                기기/에뮬레이터에 설치하는 APK (android_binary)
#
# :unit_test 는 아직 없다 — 검증할 로직이 생기는 첫 화면 작업에서 함께 만든다.
# iOS 쪽이 그렇게 했고(apps/scenetrip-ios/BUILD.bazel) 같은 순서를 따른다.
# :image / :push 는 모바일 모듈에 해당 없음 — 스토어로 나가지 클러스터로 가지 않는다.
#
# **iOS 와 달리 태그로 걸러 내지 않는다.** Android 는 리눅스에서 지어지므로 기존
# ubuntu `verify` 잡이 그대로 검사한다. 여기에 tags = ["ios"] 같은 것을 붙이면 오히려
# 검사 범위에서 빠진다 — 계획서 §5-2.
#
# Android SDK 는 Bazel 이 받아오지 못한다. 경로는 `.env` 의 ANDROID_HOME 에서 오고
# 버전은 MODULE.bazel 이 고정한다(api_level 36 · build-tools 36.1.0). 빠졌는지는
# `just doctor` 가 본다.

load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

package(default_visibility = ["//visibility:public"])

kt_android_library(
    name = "scenetrip-android",
    srcs = glob(["src/**/*.kt"]),
    manifest = "AndroidManifest.xml",
    # Compose 는 컴파일러 플러그인 없이는 **조용히 잘못 돈다** — 이유는
    # //tools/bazel/kotlin:compose_compiler_plugin 의 주석에 있다.
    plugins = ["//tools/bazel/kotlin:compose_compiler_plugin"],
    deps = [
        # 지도 SDK. aar 이라 rules_jvm_external 이 aar_import 로 감싸 준다.
        # androidx.appcompat · okhttp 등 전이 의존성이 함께 딸려 온다.
        "@maven_android//:com_naver_maps_map_sdk",

        # 계약에서 생성한 API 클라이언트. **앱은 클라이언트를 손으로 쓰지 않는다**
        # (CLAUDE.md §5). iOS 가 같은 계약에서 생성한 것을 쓰는 것과 짝이다.
        "//contracts/openapi:scene_api_kotlin_lib",

        # Compose. 껍데기(`ui`)가 아니라 **`-android` 짝**을 deps 에 적는다 —
        # 실제 클래스가 그쪽에 있고, 껍데기만 넣으면 컴파일은 되는데 링크에서
        # 클래스를 못 찾는다. 버전 못은 MODULE.bazel 에 있다.
        "@maven_android//:androidx_activity_activity_compose",
        "@maven_android//:androidx_compose_foundation_foundation_android",
        "@maven_android//:androidx_compose_foundation_foundation_layout_android",
        "@maven_android//:androidx_compose_material_material_icons_core_android",
        "@maven_android//:androidx_compose_material3_material3_android",
        "@maven_android//:androidx_compose_runtime_runtime_android",
        "@maven_android//:androidx_compose_ui_ui_android",
        "@maven_android//:androidx_compose_ui_ui_graphics_android",
        "@maven_android//:androidx_compose_ui_ui_text_android",
        "@maven_android//:androidx_compose_ui_ui_unit_android",
        "@maven_android//:androidx_lifecycle_lifecycle_runtime_compose_android",
        "@maven_android//:androidx_lifecycle_lifecycle_viewmodel_compose_android",
        "@maven_android//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@maven_android//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
    ],
)

android_binary(
    name = "bin",
    manifest = "AndroidManifest.xml",
    # iOS 와 같은 값이다. 스토어가 다르므로 충돌하지 않고, 같은 제품임이 드러난다.
    manifest_values = {
        "applicationId": "com.mz2az.scenetrip",
        "minSdkVersion": "26",
        "targetSdkVersion": "36",
        # **비워 두면 앱이 죽는다.** 적지 않으면 PackageInfo.versionName 이 null 이
        # 되는데, 지도 SDK 는 그것을 그대로 받아 User-Agent 를 만들며
        # `versionName.replace("-", ".")` 를 부른다 — 지도를 띄우는 순간 NPE 다
        # (SDK 3.23.3 의 com.naver.maps.map.b.b$a 를 디스어셈블해 확인).
        #
        # 스토어에 낼 때 올릴 값이므로 지금은 최소값으로 둔다.
        "versionCode": "1",
        "versionName": "0.1.0",
        # 매니페스트의 ${naverNcpKeyId} 를 채운다. 값은 `.env` → `just android-run`
        # → --define 경로로 온다. iOS 는 같은 값을 genrule 로 Swift 파일에 넣지만
        # (:secrets_swift), Android SDK 는 **매니페스트에서 읽는 쪽이 정상 경로다** —
        # 코드로 NaverMapSdk.client 를 넣었더니 SDK 내부에서 NPE 로 죽었다(실측).
        #
        # 소스에 박히지 않는 것은 양쪽 같다. 값이 비면 지도만 인증에 실패한다.
        "naverNcpKeyId": "$(naver_client_id)",
    },
    deps = [":scenetrip-android"],
)
