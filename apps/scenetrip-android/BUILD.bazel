# apps/scenetrip-android 의 타깃.
#
# AGENTS.md §4.1 의 이름 규칙을 따른다 — 라벨을 예측할 수 있어야 사람도 AI 도
# 이 파일을 먼저 읽지 않고 타깃을 조립할 수 있다.
#
#   :scenetrip-android  이 모듈의 주 라이브러리 (kt_android_library)
#   :bin                기기/에뮬레이터에 설치하는 APK (android_binary)
#
# :unit_test 는 아직 없다 — 검증할 로직이 생기는 첫 화면 작업에서 함께 만든다.
# iOS 쪽이 그렇게 했고(apps/scenetrip-ios/BUILD.bazel) 같은 순서를 따른다.
# :image / :push 는 모바일 모듈에 해당 없음 — 스토어로 나가지 클러스터로 가지 않는다.
#
# **iOS 와 달리 태그로 걸러 내지 않는다.** Android 는 리눅스에서 지어지므로 기존
# ubuntu `verify` 잡이 그대로 검사한다. 여기에 tags = ["ios"] 같은 것을 붙이면 오히려
# 검사 범위에서 빠진다 — 계획서 §5-2.
#
# Android SDK 는 Bazel 이 받아오지 못한다. 경로는 `.env` 의 ANDROID_HOME 에서 오고
# 버전은 MODULE.bazel 이 고정한다(api_level 36 · build-tools 36.1.0). 빠졌는지는
# `just doctor` 가 본다.

load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

package(default_visibility = ["//visibility:public"])

kt_android_library(
    name = "scenetrip-android",
    srcs = glob(["src/**/*.kt"]),
    manifest = "AndroidManifest.xml",
)

android_binary(
    name = "bin",
    manifest = "AndroidManifest.xml",
    # iOS 와 같은 값이다. 스토어가 다르므로 충돌하지 않고, 같은 제품임이 드러난다.
    manifest_values = {
        "applicationId": "com.mz2az.scenetrip",
        "minSdkVersion": "26",
        "targetSdkVersion": "36",
    },
    deps = [":scenetrip-android"],
)
