# SceneTrip 웹 — 환경 변수 이름 목록 (값은 로컬 .env 에만 둔다. 커밋 금지)

# 개발 서버 프록시가 향하는 API 서버 (기본: AWS DEV)
SCENETRIP_API_TARGET=https://api-dev.scenetrip.io

# 브라우저가 부르는 API 기준 주소. 비워 두면 같은 출처의 /v1 (개발 서버 프록시 또는 배포 시 역프록시)
VITE_API_BASE=

# 지도 SDK (미정 — docs/project/web-app.md 의 지도 절). 네이버 지도 웹 SDK 를 쓰게 되면 아래 키가 필요하다.
VITE_NAVER_MAP_CLIENT_ID=

# 소셜 로그인 웹 클라이언트 ID (미정 — docs/project/web-app.md §7). 없으면 로그인 시트가 「준비 중」 으로 안내한다. 서버의 aud 허용 목록에도 들어 있어야 한다.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# Apple 팝업이 돌아오는 주소(선택). 비우면 `<출처>/auth/callback/apple`
VITE_APPLE_REDIRECT_URI=
