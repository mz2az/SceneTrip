# apps/navi_proto 키 — 이 파일을 .env 로 복사하고 값을 채운다.
# 값은 팀 채널에서 승길에게 받는다. .env 는 gitignore 대상이다 — 절대 커밋 금지.

# TMAP (POI 수집·대중교통 실험 — 서버 실행만 할 때는 비워도 된다)
TMAP_APP_KEY=

# 네이버 공식 지역검색 (API HUB) — POI 존재 확인(매칭)에 쓴다
NAVER_CLIENT_ID=
NAVER_SEARCH_KEY_ID=
NAVER_SEARCH_KEY=

# ODsay 대중교통 (실험용 — 서버 실행만 할 때는 비워도 된다)
ODSAY_API_KEY=
ODSAY_API_KEY_URI=
ODSAY_API_KEY_IOS=
ODSAY_API_KEY_ANDROID=

# 카카오 (경로 실험용)
KAKAO_REST_KEY=
KAKAO_JS_KEY=
KAKAO_NATIVE_KEY=

# 로컬 LLM — llm.sh(:8900)를 쓰면 아래 둘은 이대로 두면 된다
LLM_URL=http://127.0.0.1:8900/v1/chat/completions
LLM_MODEL=mlx-community/Qwen3-8B-4bit

# (선택) OSRM 도보 엔진 실험 — 안 쓰면 비워 둔다
OSRM_URL=
