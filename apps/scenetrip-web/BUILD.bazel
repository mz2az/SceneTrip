# apps/scenetrip-web 의 타깃 (ADR 0028).
#
# AGENTS.md §4.1 의 이름 규칙을 따른다.
#
#   :gen          계약·iOS 리소스에서 파생되는 파일 (API 타입, 영어 문구표, 해태 그림). 커밋하지 않는다
#   :web          프로덕션 번들 dist/ (Vite 빌드). `just web-build`
#   :unit_test    vitest (jsdom). tag unit — `just web-test`
#   :lint         eslint. `just web-lint`
#   :typecheck    tsc --noEmit. `just web-lint` 가 함께 돈다
#
# 규칙은 aspect_rules_js, Node 는 MODULE.bazel 이 고정한다. npm 패키지는 package-lock.json 에서
# 파생한 pnpm-lock.yaml 로 받는다(@npm_web). 호스트 Node·npm 은 쓰지 않는다.
#
# 소스 파일을 늘리면 아래 glob 이 줍는다. **예외**: 생성물은 소스가 아니다 — `npm run gen` 이 소스
# 트리에 만든 사본이 있어도 glob 에서 뺀다(같은 경로의 소스와 산출물이 겹치면 Bazel 이 거부한다).

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@npm_web//:defs.bzl", "npm_link_all_packages")
load("@npm_web//apps/scenetrip-web:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm_web//apps/scenetrip-web:openapi-typescript/package_json.bzl", openapi_typescript_bin = "bin")
load("@npm_web//apps/scenetrip-web:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm_web//apps/scenetrip-web:vite/package_json.bzl", vite_bin = "bin")
load("@npm_web//apps/scenetrip-web:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

npm_link_all_packages(name = "node_modules")

# --- 생성물 --------------------------------------------------------------------

API_SCHEMA = "src/api/generated/schema.d.ts"

I18N_EN = "src/i18n/en.generated.json"

# iOS Images.xcassets 의 그림. 새 imageset 이 생기면 여기에 한 줄 더한다 — 다른 패키지(apps/scenetrip-ios)의
# 파일이라 glob 이 닿지 않는다. 웹이 쓰는 것은 /generated/<이름>.png 로 참조한 것뿐이다.
IOS_IMAGES = [
    "google-g.imageset/google-g.svg",
    "haetae-bow.imageset/haetae-bow.png",
    "haetae-face.imageset/haetae-face.png",
    "haetae-joy.imageset/haetae-joy.png",
    "haetae-pinhold.imageset/haetae-pinhold.png",
    "haetae-sit.imageset/haetae-sit.png",
]

PUBLIC_IMAGES = ["public/generated/" + p.split("/")[-1] for p in IOS_IMAGES]

# 계약 파일은 다른 패키지의 소스다. 도구가 bin 트리 기준으로 읽으므로 bin 으로 복사한다.
copy_file(
    name = "contract_copy",
    src = "//contracts/openapi:scene-api-v1.yaml",
    out = "contract/scene-api-v1.yaml",
)

# contracts/openapi/scene-api-v1.yaml → src/api/generated/schema.d.ts (openapi-typescript)
openapi_typescript_bin.openapi_typescript(
    name = "gen_api",
    srcs = [":contract_copy"],
    outs = [API_SCHEMA],
    args = [
        "contract/scene-api-v1.yaml",
        "-o",
        API_SCHEMA,
    ],
    chdir = package_name(),
)

js_binary(
    name = "sync_ios_assets",
    data = [
        "scripts/paths.mjs",
        "scripts/sync-ios-assets.mjs",
    ],
    entry_point = "scripts/sync-ios-assets.mjs",
)

# iOS 문구표(Localizable.strings) → src/i18n/en.generated.json, iOS 그림 → public/generated/
js_run_binary(
    name = "gen_ios",
    srcs = ["//apps/scenetrip-ios:resources/en.lproj/Localizable.strings"] +
           ["//apps/scenetrip-ios:resources/Images.xcassets/" + p for p in IOS_IMAGES],
    outs = [I18N_EN] + PUBLIC_IMAGES,
    copy_srcs_to_bin = False,
    env = {
        "SCENETRIP_IOS_ROOT": "apps/scenetrip-ios",
        "SCENETRIP_WEB_GEN_OUT": "$(RULEDIR)",
    },
    tool = ":sync_ios_assets",
)

filegroup(
    name = "gen",
    srcs = [
        ":gen_api",
        ":gen_ios",
    ],
)

# --- 소스 ----------------------------------------------------------------------

js_library(
    name = "config",
    srcs = [
        "eslint.config.js",
        "index.html",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
)

js_library(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "public/**",
            "scripts/**",
        ],
        exclude = [
            API_SCHEMA,
            I18N_EN,
            "src/api/generated/**",
            "public/generated/**",
        ],
    ),
    # 손으로 쓴 .d.ts(예: src/map/naver.d.ts)는 js_library 가 srcs 의 "types" 로만 분류해, 시험·검사의 data 로는
    # 따라오지 않는다. data 로도 한 번 더 실어야 tsc 가 찾는다.
    data = glob(
        ["src/**/*.d.ts"],
        exclude = [
            API_SCHEMA,
            "src/api/generated/**",
        ],
    ),
    deps = [":config"],
)

# 생성물까지 합친 입력. 번들·타입 검사·단위 시험이 쓴다.
js_library(
    name = "inputs",
    srcs = [":gen"],
    deps = [
        ":node_modules",
        ":sources",
    ],
)

# --- 번들 ----------------------------------------------------------------------

# `npm run build` 의 vite build 와 같다. 타입 검사(`tsc -b`)는 :typecheck 가 맡는다.
# 산출물 dist/ 에 public/ 의 _headers·_redirects·manifest 가 그대로 들어간다(Cloudflare Pages).
vite_bin.vite(
    name = "web",
    srcs = [":inputs"],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

# --- 시험·검사 -----------------------------------------------------------------

vitest_bin.vitest_test(
    name = "unit_test",
    args = ["run"],
    chdir = package_name(),
    data = [":inputs"],
    # rules_js 의 fs 패치는 realpath 를 샌드박스 안에 가둔다. vitest 의 setupFiles(심볼릭 링크)가 그 때문에 "Cannot find module" 이 된다.
    patch_node_fs = False,
    tags = [
        "unit",
    ],
)

eslint_bin.eslint_test(
    name = "lint",
    args = [
        "src",
        "scripts",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
    tags = ["lint"],
)

tsc_bin.tsc_test(
    name = "typecheck",
    args = [
        "-p",
        "tsconfig.json",
        "--noEmit",
    ],
    chdir = package_name(),
    data = [":inputs"],
    tags = ["lint"],
)
