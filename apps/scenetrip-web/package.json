{
  "name": "scenetrip-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SceneTrip 웹앱 — iOS 앱을 브라우저로 옮긴 모듈 (Bazel 로 짓고 just web-* 로 돌린다 — ADR 0028)",
  "scripts": {
    "gen": "node scripts/gen-api.mjs && node scripts/sync-ios-assets.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "check": "npm run gen && npm run typecheck && npm run lint && npm run test && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.64.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
