# 루트 패키지: 워크스페이스 전역 도구 타깃만 둔다.
# 애플리케이션 코드는 절대 여기 두지 않는다 — 배치 규칙은 AGENTS.md §2 참조.

load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@gazelle//:def.bzl", "gazelle")

package(default_visibility = ["//visibility:public"])

# gazelle:prefix github.com/scenetrip/scenetrip
# gazelle:exclude bazel-*
# gazelle:exclude third_party
gazelle(name = "gazelle")

# BUILD 파일을 제자리에서 정리한다. `just fmt` 가 호출한다.
buildifier(
    name = "buildifier",
    exclude_patterns = ["./bazel-*/**"],
    lint_mode = "fix",
    mode = "fix",
)

# 포맷이 어긋나거나 린트를 통과하지 못한 BUILD 파일이 있으면 실패한다.
# `just fmt-check` 와 `just lint` 가 호출하므로 `just check` 와 CI 도 거쳐 간다.
buildifier(
    name = "buildifier_check",
    exclude_patterns = ["./bazel-*/**"],
    lint_mode = "warn",
    mode = "diff",
)
