# 루트 패키지: 워크스페이스 전역 도구 타깃만 둔다.
# 애플리케이션 코드는 절대 여기 두지 않는다 — 배치 규칙은 AGENTS.md §2 참조.
#
# 여기 있는 도구는 전부 **Bazel 이 받아온다.** 호스트에 깔린 것에 의존하지 않으므로
# (AGENTS.md §4.3) 사람마다 버전이 달라 결과가 갈리는 일이 없고, CI 러너도 별도 설치
# 없이 같은 버전을 쓴다.

load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_java//java:defs.bzl", "java_binary")

package(default_visibility = ["//visibility:public"])

# --- BUILD 파일 ----------------------------------------------------------------

# BUILD 파일을 제자리에서 정리한다. `just fmt` 가 호출한다.
buildifier(
    name = "buildifier",
    exclude_patterns = ["./bazel-*/**"],
    lint_mode = "fix",
    mode = "fix",
)

# 포맷이 어긋나거나 린트를 통과하지 못한 BUILD 파일이 있으면 실패한다.
# `just fmt-check` 와 `just lint` 가 호출하므로 `just check` 와 CI 도 거쳐 간다.
buildifier(
    name = "buildifier_check",
    exclude_patterns = ["./bazel-*/**"],
    lint_mode = "warn",
    mode = "diff",
)

# --- Java ----------------------------------------------------------------------

# Java 포매터. `just fmt` / `just fmt-check` 가 tools/scripts/format.sh 를 통해 부른다.
#
# jvm_flags 가 필요한 이유: google-java-format 은 javac 내부 API 로 소스를 파싱하는데,
# JDK 16 부터 그 패키지들이 기본으로 닫혀 있다. 열어 주지 않으면
# IllegalAccessError 로 죽는다.
java_binary(
    name = "google_java_format",
    jvm_flags = [
        "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    main_class = "com.google.googlejavaformat.java.Main",
    runtime_deps = ["@maven//:com_google_googlejavaformat_google_java_format"],
)

# Java 린터. `just lint` 가 tools/scripts/lint.sh 를 통해 부른다.
java_binary(
    name = "checkstyle",
    main_class = "com.puppycrawl.tools.checkstyle.Main",
    runtime_deps = ["@maven//:com_puppycrawl_tools_checkstyle"],
)
