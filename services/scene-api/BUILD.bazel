# services/scene-api 의 타깃.
#
# AGENTS.md §4.1 의 이름 규칙을 따른다:
#   :scene-api    이 모듈의 주 라이브러리
#   :bin          실행 가능 jar (Spring Boot)
#   :unit_test    빠르고 격리됨 (tags = ["unit"])
#
# 빌드 경로는 ADR 0003 — Bazel 이 실행 가능 jar 를 만들고 Dockerfile 은 그것을 담기만
# 한다. Gradle·Maven 을 빌드 경로로 쓰지 않으므로 이 저장소에 build.gradle 은 없다.
#
# DEV·PRD :image / :push 는 rules_oci 로 만든다. 로컬 kind의 기존
# Dockerfile 경로(`just image scene-api`)는 개발용으로 유지한다.

load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_spring//springboot:springboot.bzl", "springboot")
load("//tools/bazel/defs:java_junit5_test.bzl", "java_junit5_test")

package(default_visibility = ["//visibility:public"])

# 배포기 시험(tools/aws)이 원격 적재 스크립트의 단계 줄 형식을 확인한다.
exports_files(
    ["seed/remote-load.sh"],
    visibility = ["//tools/aws:__pkg__"],
)

# 배포 전 DB 통합 검증도 서비스가 소유한 마이그레이션 한 벌을 사용한다.
filegroup(
    name = "migrations",
    srcs = glob(["src/main/resources/db/migration/*.sql"]),
)

# DEV·PRD는 같은 linux/amd64 산출물을 digest로 승격한다. Docker daemon은 필요 없다.
pkg_tar(
    name = "runtime_layer",
    srcs = [
        ":bin.jar",
        "@otel_javaagent//file",
    ],
    mode = "0444",
    package_dir = "/app",
)

oci_image(
    name = "image",
    base = "@java21_runtime_linux_amd64",
    entrypoint = [
        "/usr/bin/java",
        "-javaagent:/app/opentelemetry-javaagent.jar",
        "-jar",
        "/app/bin.jar",
    ],
    tars = [":runtime_layer"],
    user = "65532:65532",
    workdir = "/app",
)

pkg_tar(
    name = "migration_layer",
    srcs = [":migrate_deploy.jar"],
    mode = "0444",
    package_dir = "/app",
)

oci_image(
    name = "migration_image",
    base = "@java21_runtime_linux_amd64",
    entrypoint = [
        "/usr/bin/java",
        "-cp",
        "/app/migrate_deploy.jar",
        "com.mz2az.scenetrip.sceneapi.DbMigrate",
    ],
    tars = [":migration_layer"],
    user = "65532:65532",
    workdir = "/app",
)

oci_push(
    name = "push",
    image = ":image",
    repository = "localhost/scenetrip/scene-api",
    tags = ["manual"],
)

oci_push(
    name = "migration_push",
    image = ":migration_image",
    repository = "localhost/scenetrip/scene-api-migration",
    tags = ["manual"],
)

# ── 원격 데이터 적재 이미지 (MZ2AZ-414, docs/project/plans/remote-data-load.md) ──────────────────────
#
# psql 이 든 postgres(배포기 DB 초기화 Job 과 같은 digest) 위에 적재 SQL·스크립트·데이터를 얹는다. Job 이 밖으로 내려받지
# 않게 데이터가 이미지에 박힌다 — 태그(커밋)와 데이터가 함께 고정된다. 편의시설 판(약 71 MB)과 기반 이미지 때문에 크다 —
# 전부 manual 이라 `just check` 는 받지 않는다. 배포기가 `just run :data_load_push` 로, 로컬 검증이 `:data_load_load` 로 짓는다.
pkg_tar(
    name = "data_load_seed_layer",
    srcs = [
        "seed/candidates.csv",
        "seed/candidates.sql",
        "seed/place_poi_link.sql",
        "seed/place_poi_links.tsv",
        "seed/poi.sql",
        "seed/poi_dedupe.sql",
        "seed/poi_detail.sql",
        "seed/poi_detail_load.sql",
        "seed/poi_merged_2026-06.tsv",
        "seed/poi_source_merged.sql",
        "seed/poi_update.sql",
    ],
    mode = "0444",
    package_dir = "/data/seed",
    tags = ["manual"],
)

pkg_tar(
    name = "data_load_poi_layer",
    srcs = [
        "@poi_release_manifest//file",
        "@poi_release_poi_food//file",
        "@poi_release_poi_sight//file",
        "@poi_release_poi_stay//file",
        "@poi_release_poi_tour_food//file",
        "@poi_release_poi_tour_stay//file",
        "@poi_release_poi_transit//file",
    ],
    mode = "0444",
    package_dir = "/data/poi",
    tags = ["manual"],
)

# 관광공사 상세 한 판(MODULE.bazel 의 poi_detail_*) — POI 다음에 넣는다(MZ2AZ-376).
pkg_tar(
    name = "data_load_poi_detail_layer",
    srcs = [
        "@poi_detail_en//file",
        "@poi_detail_ko//file",
        "@poi_detail_manifest//file",
    ],
    mode = "0444",
    package_dir = "/data/poi-detail",
    tags = ["manual"],
)

pkg_tar(
    name = "data_load_script_layer",
    srcs = ["seed/remote-load.sh"],
    mode = "0555",
    package_dir = "/data",
    tags = ["manual"],
)

oci_image(
    name = "data_load_image",
    base = "@postgres_client_linux_amd64",
    # 기반 이미지의 entrypoint(postgres 서버 기동 스크립트)를 쓰지 않는다 — 이 이미지는 클라이언트다.
    entrypoint = [
        "/bin/bash",
        "/data/remote-load.sh",
    ],
    env = {"TMPDIR": "/tmp"},
    tags = ["manual"],
    tars = [
        ":data_load_seed_layer",
        ":data_load_poi_layer",
        ":data_load_poi_detail_layer",
        ":data_load_script_layer",
    ],
    # 배포 Job 들과 같은 비루트 사용자(Pod Security restricted). /tmp 는 Job 이 emptyDir 로 붙인다.
    user = "10001:10001",
    workdir = "/tmp",
)

oci_push(
    name = "data_load_push",
    image = ":data_load_image",
    repository = "localhost/scenetrip/data-load",
    tags = ["manual"],
)

# 로컬 검증 — docker 에 올린 뒤 kind 에 싣는다(`just data-load-local`).
oci_load(
    name = "data_load_load",
    image = ":data_load_image",
    repo_tags = ["scenetrip/data-load:dev"],
    tags = ["manual"],
)

# deps 와 runtime_deps 를 나눈 이유:
#
# `spring-boot-starter-*` 는 POM 만 있는 묶음 아티팩트라 클래스가 없다. 컴파일에는
# 클래스를 실제로 담은 아티팩트(spring-boot, spring-boot-autoconfigure)가 필요하고,
# 스타터는 런타임 클래스패스를 채우는 용도로 runtime_deps 에 둔다.
#
# Spring Boot 4 는 자동 구성이 여러 모듈로 쪼개져 있어(spring-boot-webmvc,
# spring-boot-actuator-autoconfigure …) 스타터 없이 직접 나열하면 빠뜨리기 쉽다.
java_library(
    name = "scene-api",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["src/main/java/com/mz2az/scenetrip/sceneapi/post/PostBody.java"],
    ) + ["src/main/java/com/mz2az/scenetrip/sceneapi/post/PostBody.java"],
    resources = glob(["src/main/resources/**"]),
    runtime_deps = [
        # 방언과 드라이버는 코드에서 부르지 않는다. 클래스패스에 있으면 Flyway 와 Spring
        # 이 찾아 쓴다 — 그래서 deps 가 아니라 runtime_deps 다. 세 아티팩트가 각각 왜
        # 필요한지는 MODULE.bazel 에 적었다.
        #
        # flyway-core 는 여기 없다. DbMigrate 가 직접 부르므로 deps 로 올라갔다.
        "@maven//:org_flywaydb_flyway_database_postgresql",
        "@maven//:org_postgresql_postgresql",
        "@maven//:org_springframework_boot_spring_boot_starter_actuator",
        "@maven//:org_springframework_boot_spring_boot_starter_flyway",
        "@maven//:org_springframework_boot_spring_boot_starter_jdbc",
        # @Size·@Min 을 실제로 검사하는 구현(hibernate-validator)이 여기 들어 있다.
        # 없으면 표식만 붙고 검사가 일어나지 않아, 명세가 400 을 약속한 요청이
        # 그대로 통과한다.
        "@maven//:org_springframework_boot_spring_boot_starter_validation",
        "@maven//:org_springframework_boot_spring_boot_starter_web",
    ],
    deps = [
        # 명세에서 생성한 인터페이스와 응답 모델. 컨트롤러가 이것을 구현하므로
        # 명세와 어긋나면 컴파일이 실패한다 — 계약이 지켜지는지를 사람이 아니라
        # 컴파일러가 본다.
        "//contracts/openapi:scene_api_spring_lib",
        # 카카오 응답 record 의 @JsonIgnoreProperties. 카카오가 필드를 더해도 깨지지
        # 않아야 하는데, 그것을 Boot 의 ObjectMapper 기본값에만 맡기지 않고 그 record
        # 에 박아 둔다 — "이 응답은 우리 통제 밖" 이라는 표시다. 아티팩트는 이미
        # 전이 의존으로 잠겨 있어 MODULE.bazel 은 그대로다.
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        # JWT 서명·검증과 구글·애플 공개키 검증 (ADR 0018, MODULE.bazel 의 이유).
        "@maven//:com_nimbusds_nimbus_jose_jwt",
        # ObservationRegistry 타입. 카카오 클라이언트가 나가는 호출을 Spring 관측에 걸어
        # 대중교통·도보를 uri 태그로 가른다. 런타임엔 액추에이터가 끌고 오지만 컴파일에
        # 그 타입을 쓰려면 여기 있어야 한다. 잠금 파일에 이미 있어 MODULE.bazel 은 그대로다.
        "@maven//:io_micrometer_micrometer_observation",
        # DbMigrate 가 Flyway 를 직접 부른다 — 앱 없이 스키마만 올리는 명령이다.
        # 앱 기동 시의 자동 구성은 그대로이고, 이것은 그 밖의 경로다 (ADR 0005).
        "@maven//:org_flywaydb_flyway_core",
        # 사용자 사진 저장소(S3) — 서명된 올릴·볼 주소와 옮기기(review/S3PhotoStorage, MODULE.bazel 의 이유).
        # s3 · regions · sdk-core · url-connection-client 는 코드가 직접 부르는 타입이 든 묶음이다.
        "@maven//:software_amazon_awssdk_auth",
        "@maven//:software_amazon_awssdk_regions",
        "@maven//:software_amazon_awssdk_s3",
        "@maven//:software_amazon_awssdk_sdk_core",
        "@maven//:software_amazon_awssdk_url_connection_client",
        "@maven//:io_opentelemetry_opentelemetry_api",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:jakarta_validation_jakarta_validation_api",
        # CurrentAccount 가 요청의 Authorization 헤더를 읽는다(HttpServletRequest).
        "@maven//:jakarta_servlet_jakarta_servlet_api",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_jdbc",
        # DuplicateKeyException 이 여기 있다. 장바구니 중복은 DB 의 기본키가 막고,
        # 그 제약 위반을 잡아 409 로 바꾼다.
        "@maven//:org_springframework_spring_tx",
        "@maven//:org_springframework_spring_web",
        # NoResourceFoundException 이 여기 있다. spring-web 이 아니라 spring-webmvc 다 —
        # 매핑되지 않은 경로를 정적 리소스 처리기가 다루기 때문이다. 그것을 404 로 바꾸지
        # 않으면 마지막 그물에 걸려 500 으로 나간다 (ApiExceptionHandler).
        "@maven//:org_springframework_spring_webmvc",
        "@maven//:tools_jackson_core_jackson_databind",
    ],
)

# 실행 가능 jar. rules_spring 이 자동 구성 목록처럼 "합쳐져야 하는" 리소스를 병합해
# 준다 — 평범한 java_binary 의 deploy jar 는 같은 경로의 첫 번째 것만 남기고 버린다.
#
# boot_launcher_class 를 명시하는 이유: rules_spring 의 기본값은 Boot 2 시절의
# org.springframework.boot.loader.JarLauncher 인데, Boot 3 에서 런처가 다시 쓰이면서
# 패키지가 …loader.launch 로 바뀌었다. 기본값을 그대로 두면 MANIFEST 의 Main-Class 가
# 존재하지 않는 클래스를 가리켜 jar 가 실행되지 않는다.
#
# deps 에 spring-boot-loader 를 넣는 이유: springboot_pkg.sh 가 이름에
# 'spring-boot-loader' 가 든 jar 를 찾아 BOOT-INF/lib 이 아니라 **jar 루트**에 풀어
# 넣는다. 부트스트랩 클래스는 중첩 jar 밖에 있어야 JVM 이 찾을 수 있기 때문이다.
springboot(
    name = "bin",
    boot_app_class = "com.mz2az.scenetrip.sceneapi.SceneApiApplication",
    boot_launcher_class = "org.springframework.boot.loader.launch.JarLauncher",
    java_library = ":scene-api",
    deps = ["@maven//:org_springframework_boot_spring_boot_loader"],
)

# 스키마만 올리는 명령. `just db-migrate` 가 돌린다.
#
# 앱은 기동할 때 Flyway 를 자동으로 돌리지만, **앱 없이 스키마만 필요한 자리**가 있다 —
# CI 의 통합 테스트와, 배포 전에 마이그레이션만 먼저 올리는 경우다 (ADR 0005).
#
# :scene-api 에 의존하므로 마이그레이션 파일이 앱과 같은 것 하나다. 두 벌이 되면
# "앱은 올라가는데 CI 는 스키마가 다른" 상황이 생긴다.
java_binary(
    name = "migrate",
    main_class = "com.mz2az.scenetrip.sceneapi.DbMigrate",
    runtime_deps = [
        ":scene-api",
        "@maven//:org_flywaydb_flyway_core",
        "@maven//:org_flywaydb_flyway_database_postgresql",
        "@maven//:org_postgresql_postgresql",
    ],
)

# 실제 PostgreSQL 에 SQL 을 태우는 레인. `just test-integration` 이 돌린다.
#
# 왜 필요한가: :unit_test 는 Store 를 가짜로 바꿔 끼우므로 SQL 이 한 줄도 실행되지
# 않는다. Store 4 개의 질의 1,100 줄이 컬럼 오타 하나에도 게이트를 통과하고, 운영에서
# 처음 터진다. 실제로 검색 분기 하나가 빠져 작품 탭이 비어 있었는데 게이트는 내내
# 초록이었다 — 이 레인이 그 자리를 메운다.
#
# 태그의 뜻:
#   integration     `just test` 에서 제외되고 `just test-integration` 에서만 돈다.
#   requires-network  샌드박스의 망 차단을 풀어 준다. DB 로 TCP 를 열어야 한다.
#   external        캐시하지 않고 매번 실행한다. 입력 파일이 그대로여도 DB 내용은
#                   바뀌므로, 캐시된 초록은 "지금도 통과한다" 는 뜻이 아니다.
#
# size 가 medium 인 이유: 접속과 질의가 있어 small 의 기본 제한(60 초)에 걸릴 수 있다.
java_junit5_test(
    name = "integration_test",
    size = "medium",
    srcs = glob(["tests/integration/java/**/*.java"]),
    # PoiUpdateIntegrationTest 가 적재가 psql 로 돌리는 바로 그 파일을 JDBC 로 돌린다.
    # place_poi_link.sql 도 같다 — 같은 곳 연결(MZ2AZ-371)을 실제 DB 에 돌려 본다. poi_detail.sql 은 관광공사 상세·사진 맞추기.
    data = [
        "seed/course_pin_to_poi.sql",
        "seed/place_poi_link.sql",
        # 번호 기록(MZ2AZ-491) — 합쳐진 번호 넣기·같은 가게 정리를 같은 방식으로 JDBC 로 돌리고, 합쳐진 번호 파일의 모양을 본다.
        "seed/poi_dedupe.sql",
        "seed/poi_detail.sql",
        "seed/poi_merged_2026-06.tsv",
        "seed/poi_source_merged.sql",
        "seed/poi_update.sql",
    ],
    tags = [
        "external",
        "integration",
        "requires-network",
    ],
    test_package = "com.mz2az.scenetrip.sceneapi",
    runtime_deps = [
        "@maven//:org_postgresql_postgresql",
    ],
    deps = [
        ":scene-api",
        "//contracts/openapi:scene_api_spring_lib",
        # AuthFlowIntegrationTest 가 CurrentAccount 에 넣을 요청(MockHttpServletRequest)을 만들고
        # 컨트롤러의 ResponseEntity 를 읽는다 — 스프링 컨텍스트 없이 실제 Store 로 흐름을 태운다.
        "@maven//:jakarta_servlet_jakarta_servlet_api",
        # GoogleSignInIntegrationTest 가 이 자리에서 만든 RSA 키로 구글처럼 생긴 ID 토큰을 서명하고,
        # 검증기에 그 공개키 한 장짜리 키 묶음을 준다 — 실제 구글을 부르지 않는다.
        "@maven//:com_nimbusds_nimbus_jose_jwt",
        # GuideChatQuotaFlowIntegrationTest 가 가짜 에이전트(로컬 HTTP 서버)로 GuideAgentClient 를 만들고(NOOP 관측),
        # 요청·응답 JSON 을 JsonMapper 로 읽고 쓴다 — 실제 에이전트·모델은 부르지 않는다.
        "@maven//:io_micrometer_micrometer_observation",
        "@maven//:tools_jackson_core_jackson_databind",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_springframework_spring_jdbc",
        "@maven//:org_springframework_spring_test",
        "@maven//:org_springframework_spring_tx",
        "@maven//:org_springframework_spring_web",
    ],
)

# size 가 medium(300 초)인 이유: 로컬 19 초지만 CI 러너가 Android 빌드와 겹쳐 바쁠 때 small 의 60 초를 두 번 넘겼다
# (2026-10-10, #189 머지 뒤 main). 시험이 멈춘 것이 아니라 제한이 빠듯했다. 단위 시험은 600 개를 넘었다.
java_junit5_test(
    name = "unit_test",
    size = "medium",
    srcs = glob(
        ["tests/java/**/*.java"],
        exclude = [
            "tests/java/com/mz2az/scenetrip/sceneapi/post/PostBodyTest.java",
            "tests/java/com/mz2az/scenetrip/sceneapi/web/PostsBlogControllerTest.java",
        ],
    ) + [
        "tests/java/com/mz2az/scenetrip/sceneapi/post/PostBodyTest.java",
        "tests/java/com/mz2az/scenetrip/sceneapi/web/PostsBlogControllerTest.java",
    ],
    tags = ["unit"],
