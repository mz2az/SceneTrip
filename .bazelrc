# SceneTrip Bazel 설정.
#
# 이름 붙은 config 는 just 레시피가 고른다(--config=ci, --config=release 등).
# 명령줄에서 임시 플래그를 붙이지 말고 여기에 config 를 추가한다. 그래야 로컬과 CI 가
# 어긋나지 않는다.

# --- 공통 --------------------------------------------------------------------

common --enable_platform_specific_config
common --incompatible_disallow_empty_glob

# --- 빌드 --------------------------------------------------------------------

build --verbose_failures
build --incompatible_strict_action_env          # 격리: 호스트 환경 차이를 무시한다
build --experimental_repository_cache_hardlinks
build --nolegacy_external_runfiles

# 워크스페이스 루트를 깨끗하게 유지한다. 심볼릭 링크는 gitignore 대상이다.
build --symlink_prefix=bazel-

# --- 플랫폼별: 리눅스는 iOS 타깃을 거른다 ---------------------------------------
# iOS 는 macOS + Xcode 에서만 지어진다. target_compatible_with 만으로는 리눅스
# 와일드카드 빌드를 지키지 못한다(실측) — ios_application 이 타깃 플랫폼을 iOS 로
# 전환한 뒤 제약이 평가되므로 호스트 OS 를 구분하지 못하고, 리눅스에서는 조용한
# 스킵 대신 툴체인 해석 실패로 빌드 전체가 죽는다. 그래서 iOS 모듈의 모든 타깃에
# tags = ["ios"] 를 달고, 리눅스에서만 태그로 걸러낸다 (enable_platform_specific_config
# 가 호스트 OS 이름의 config 를 자동 적용한다). macOS 에서는 아무것도 거르지 않는다.
#
# 주의: 테스트 레인 레시피가 명령줄에서 --test_tag_filters 를 넘기면 이 값을
# **덮어쓴다** (태그 필터는 누적이 아니다). 즉 아래 test:linux 줄은 `just test` 계열에
# 실제로는 걸리지 않는다.
#
# 지금 무해한 이유는 iOS 테스트 타깃이 0 개이기 때문이다 (apps/scenetrip-ios/BUILD.bazel
# 의 ":unit_test 는 아직 없다"). **첫 iOS 테스트 타깃이 생기는 시점**이 이것을 정리할
# 때다 — CI macOS 잡을 만들 때 같이 하려 했으나(계획서 §5-4) 그 잡만으로는 고칠 수
# 없다는 것이 드러났다. 레시피에 -ios 를 그냥 더하면 macOS 잡에서도 iOS 테스트가
# 걸러져 정작 검사해야 할 곳이 검사를 안 하게 된다. 올바른 해법은 필터를 명령줄에서
# 빼 .bazelrc 로 옮겨 플랫폼별 config 가 이기게 하는 것이고, 그것은 tools/just/test.just
# 를 함께 고쳐야 한다.
build:linux --build_tag_filters=-ios
test:linux --test_tag_filters=-ios

# --- Java --------------------------------------------------------------------
# 언어 수준을 고정하지 않으면 Bazel 이 -source 11 -target 11 로 컴파일한다.
# Spring Boot 4 는 Java 17 이상을 요구하므로 그 조합에서는 빌드가 깨진다.
# 스택은 Java 21 LTS 로 확정했다 (ADR 0003, docs/project/plans/scene-api-service-module.md).
#
# java_runtime_version 은 Bazel 이 내려받는 JDK 를 고정한다 — 호스트에 무엇이 깔려
# 있든 같은 JDK 로 빌드된다 (AGENTS.md §4.3 "호스트 툴체인 금지").
build --java_language_version=21
build --tool_java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21

# --- 테스트 ------------------------------------------------------------------

test --test_output=errors
test --test_summary=terse
test --build_tests_only
test --test_verbose_timeout_warnings

# --- 컴파일 모드 --------------------------------------------------------------

build:debug --compilation_mode=dbg
build:release --compilation_mode=opt
build:release --stamp

# --- CI ----------------------------------------------------------------------
# `just ci-full` 이 고른다. 읽기 좋은 로그와 최대한의 신호를 목표로 한다.

build:ci --announce_rc
build:ci --show_timestamps
build:ci --color=yes
build:ci --keep_going
build:ci --curses=no
test:ci --test_output=errors
test:ci --flaky_test_attempts=2
test:ci --build_tests_only

# --- 린트 --------------------------------------------------------------------
# 현재 `just lint` 는 buildifier 와 tools/scripts/lint.sh 를 돌린다. tools/bazel/defs/ 에
# 린트 애스펙트를 추가하면 여기에 연결하고 레시피를 `--config=lint` 로 바꾼다.
# 그러면 린트도 빌드 캐시의 혜택을 받는다.

# --- 원격 캐시 ----------------------------------------------------------------
# 공용 캐시가 생기면 주석을 풀고 주소를 채운다. 로컬 개발자는 읽기 전용이고,
# 쓰기 자격 증명은 CI 가 갖는다.
#
# build:remote --remote_cache=grpcs://<캐시-호스트>
# build:remote --remote_timeout=3600
# build:remote --remote_upload_local_results=false
# build:ci --config=remote
# build:ci --remote_upload_local_results=true

# --- 개인 설정 ----------------------------------------------------------------
# 머신 전용 설정은 .bazelrc.user 에 만든다. gitignore 대상이며, 빌드 성공에
# 이 파일이 필요해서는 안 된다.

try-import %workspace%/.bazelrc.user
