root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,bzl}]
indent_size = 4

[{BUILD,BUILD.bazel,MODULE.bazel,*.bzl}]
indent_size = 4

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[{justfile,*.just}]
indent_size = 4
