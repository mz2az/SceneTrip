root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,bzl}]
indent_size = 4

[{BUILD,BUILD.bazel,MODULE.bazel,*.bzl}]
indent_size = 4

# Java: google-java-format 기본값이 2칸이다 (just fmt 가 쓰는 포매터).
[*.java]
indent_size = 2

# Kotlin 공식 스타일과 ktlint 기본값
[*.{kt,kts}]
indent_size = 4

# Swift 관례(Xcode 기본값)
[*.swift]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{justfile,*.just}]
indent_size = 4
