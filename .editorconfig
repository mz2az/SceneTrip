root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,bzl}]
indent_size = 4

[{BUILD,BUILD.bazel,MODULE.bazel,*.bzl}]
indent_size = 4

# Java: google-java-format 기본값이 2칸이다 (just fmt 가 쓰는 포매터).
[*.java]
indent_size = 2

# Kotlin 공식 스타일과 ktlint 기본값
[*.{kt,kts}]
indent_size = 4
# Compose 의 `@Composable` 함수는 **대문자로 시작한다.** 화면 조각을 뜻하므로
# 타입처럼 이름 짓는 것이 Compose 의 공식 관례이고, 소문자로 바꾸면 우리 코드만
# 세상의 모든 Compose 예제와 달라진다.
#
# ktlint 의 function-naming 규칙은 이것을 모른다. **규칙을 끄지 않는다** — 평범한
# 함수는 그대로 검사받아야 한다. 이 설정은 `@Composable` 이 붙은 것만 예외로 뺀다.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Swift 관례(Xcode 기본값)
[*.swift]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{justfile,*.just}]
indent_size = 4
