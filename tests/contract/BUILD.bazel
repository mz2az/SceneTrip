# 계약 테스트 — 생산자와 소비자가 contracts/ 의 정의를 지키는지 검증한다.
#
# 이 파일이 존재해야 하는 이유부터: BUILD.bazel 이 없으면 Bazel 은 이 디렉터리를
# 패키지로 인식하지 못하고 `//tests/contract/...` 를 "대상 없음" 이 아니라
# **에러**로 처리한다. 그러면 `just test-contract` 가 그냥 죽는다 —
# contracts/README.md 가 "모든 계약 변경은 just test-contract 로 검증한다" 고
# 지시하는데 정작 그 명령이 실행되지 않는 상태가 된다.
#
# 여기서 검증하는 것:
#
#   명세 하나가 소비자 셋 모두에게 코드를 내주는가.
#
# SceneTrip 의 소비자는 서버(Spring) · iOS(Swift) · Android(Kotlin) 셋이고
# 셋 다 같은 명세를 읽는다. 한 언어에서만 깨지는 변경이 실재하므로 셋을 함께 돌린다.
#
# **이 테스트가 잡는 것과 못 잡는 것을 구분할 것.**
#
#   잡는다   생성이 실패하는 변경 — 깨진 $ref, 잘못된 문법, 지원하지 않는 구성.
#            한 언어에서만 실패해도 걸린다.
#   못 잡는다 생성은 되지만 결과가 이상한 경우. 생성기 경고는 빌드를 멈추지 않는다.
#            실제 사례: 스키마 이름 `Error` 는 Spring·Kotlin 에서 멀쩡했지만 Swift
#            예약어라 생성기가 `ModelError` 로 조용히 개명했다(경고 63 건). 이런
#            것은 사람이 생성 결과를 볼 때 발견된다.
#
# 앱 모듈이 아직 없어 생성 결과를 컴파일해 볼 수는 없다. 그래도 "명세가 그
# 언어의 생성기를 통과하는가" 는 지금 검증할 수 있고, 그것이 계약 테스트의 몫이다.
# 컴파일까지의 검증은 앱 모듈이 들어올 때 그 모듈의 테스트가 맡는다.

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@openapi_tools_generator_bazel//:defs.bzl", "openapi_generator")

package(default_visibility = ["//visibility:private"])

# iOS 소비자 — 앱 모듈이 생기면 이 생성기가 apps/<name>-ios 의 클라이언트가 된다.
openapi_generator(
    name = "scene_api_swift",
    generator = "swift5",
    spec = "//contracts/openapi:scene-api-v1.yaml",
)

# Android 소비자 — 마찬가지로 apps/<name>-android 의 클라이언트가 된다.
openapi_generator(
    name = "scene_api_kotlin",
    generator = "kotlin",
    spec = "//contracts/openapi:scene-api-v1.yaml",
)

# 셋이 모두 생성되는지 확인한다. 생성기는 코드를 뽑기 전에 명세를 파싱·검증하므로
# 명세가 깨지면 여기서 걸린다.
#
# `unit` 태그를 붙인 이유: 이 테스트는 격리돼 있고 네트워크·컨테이너가 필요 없으며
# 빠르다(tests/README.md 가 계약 레인을 "빠름" 으로 규정). 태그 덕분에
# `just test-contract` 뿐 아니라 빠른 레인(`just test`)과 `just check` 에서도
# 함께 돌아, 계약이 깨진 채로 커밋되는 것을 막는다.
build_test(
    name = "scene_api_contract_test",
    tags = ["unit"],
    targets = [
        ":scene_api_kotlin",
        ":scene_api_swift",
        "//contracts/openapi:scene_api_spring",
    ],
)
