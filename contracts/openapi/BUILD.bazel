# contracts/openapi/ 의 타깃.
#
# 명세로부터 코드를 생성한다. 생성물은 Bazel 산출물이므로 커밋하지 않는다
# (contracts/README.md).
#
# 이 타깃들이 곧 명세의 검사기다 — 생성기는 명세를 먼저 파싱·검증하므로, 참조가
# 깨졌거나 문법이 어긋나면 빌드가 실패한다. `just check` 가 `bazel build //...`
# 을 돌리므로 게이트에 자동으로 포함된다.
#
# 언어를 늘릴 때: generator 만 바꿔 타깃을 추가한다.
#   swift5  → iOS 앱 클라이언트   (apps/<name>-ios 가 생길 때)
#   kotlin  → Android 앱 클라이언트 (apps/<name>-android 가 생길 때)

load("@openapi_tools_generator_bazel//:defs.bzl", "openapi_generator")

package(default_visibility = ["//visibility:public"])

# 계약 테스트(//tests/contract)가 이 명세를 직접 참조한다.
exports_files(["scene-api-v1.yaml"])

# scene-api 의 Spring 서버 인터페이스.
# 컨트롤러가 이 인터페이스를 구현하면 계약 위반이 컴파일 오류가 된다.
openapi_generator(
    name = "scene_api_spring",
    generator = "spring",
    spec = "scene-api-v1.yaml",
)
