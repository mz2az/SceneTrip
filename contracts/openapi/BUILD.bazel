# contracts/openapi/ 의 타깃.
#
# 명세로부터 코드를 생성한다. 생성물은 Bazel 산출물이므로 커밋하지 않는다
# (contracts/README.md).
#
# 이 타깃들이 곧 명세의 검사기다 — 생성기는 명세를 먼저 파싱·검증하므로, 참조가
# 깨졌거나 문법이 어긋나면 빌드가 실패한다. `just check` 가 `bazel build //...`
# 을 돌리므로 게이트에 자동으로 포함된다.
#
# 언어를 늘릴 때: generator 만 바꿔 타깃을 추가한다.
#   swift5  → iOS 앱 클라이언트   (apps/<name>-ios)
#   kotlin  → Android 앱 클라이언트 (apps/<name>-android)

load("@openapi_tools_generator_bazel//:defs.bzl", "openapi_generator")
load("@rules_java//java:defs.bzl", "java_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/bazel/defs:merge_tree_sources.bzl", "merge_tree_sources")
load("//tools/bazel/defs:tree_srcjar.bzl", "tree_srcjar")

package(default_visibility = ["//visibility:public"])

# 계약 테스트(//tests/contract)가 이 명세를 직접 참조한다.
exports_files(["scene-api-v1.yaml"])

# scene-api 의 Spring 서버 인터페이스.
# 컨트롤러가 이 인터페이스를 구현하면 계약 위반이 컴파일 오류가 된다.
#
# interfaceOnly 를 켜는 이유: 이것이 없으면 생성기가 자기 나름의 Spring Boot 애플리
# 케이션을 통째로 만든다 — @SpringBootApplication 클래스, HomeController,
# springdoc 설정, 그리고 501 을 반환하는 컨트롤러 스텁까지. 우리에게는 이미
# SceneApiApplication 이 있고, 생성된 껍데기가 클래스패스에 같이 있으면 자동 구성이
# 어느 쪽을 잡을지가 우연에 맡겨진다.
#
# useSpringBoot3 는 jakarta.* 임포트를 쓰게 한다. 끄면 javax.* 가 나오는데 Spring
# Boot 4 에는 그 클래스가 없어 컴파일이 깨진다.
#
# openApiNullable 을 끄는 이유: org.openapitools.jackson.nullable 라는 별도 라이브러리를
# 끌어온다. "값이 없음" 과 "필드가 아예 없음" 을 구분하는 용도인데, 우리 명세는 PATCH
# 가 없어 그 구분이 필요한 자리가 없다.
openapi_generator(
    name = "scene_api_spring",
    additional_properties = {
        "interfaceOnly": "true",
        "useSpringBoot3": "true",
        "openApiNullable": "false",
        "hideGenerationTimestamp": "true",
        "useTags": "true",
    },
    api_package = "com.mz2az.scenetrip.sceneapi.api",
    generator = "spring",
    model_package = "com.mz2az.scenetrip.sceneapi.api.model",
    spec = "scene-api-v1.yaml",
)

# 사람이 읽는 API 레퍼런스. `just docs-api` 가 이것을 빌드해 브라우저로 연다.
#
# 명세 자체(scene-api-v1.yaml)를 읽어도 되지만 900 줄이고 $ref 로 흩어져 있어, 엔드포인트
# 하나가 무엇을 받고 무엇을 돌려주는지 한눈에 보이지 않는다. 이 산출물은 그것을
# 엔드포인트별로 펼쳐 놓는다.
#
# 명세를 하나로 합쳐 정규화한 JSON.
#
# 두 가지 일을 한다. 첫째로 $ref 로 흩어진 조각을 한 파일에 모으고, 둘째로 이 규칙이
# 돌면서 명세를 파싱·검증하므로 문법이 깨지면 여기서 빌드가 멈춘다.
#
# 아래 문서 페이지가 이것을 그대로 박아 넣는다. YAML 이 아니라 JSON 인 이유는
# 자바스크립트가 추가 라이브러리 없이 읽을 수 있는 형식이기 때문이다.
openapi_generator(
    name = "scene_api_openapi_json",
    generator = "openapi",
    spec = "scene-api-v1.yaml",
)

# iOS 앱이 쓰는 Swift 클라이언트.
#
# 앱은 API 클라이언트를 손으로 쓰지 않는다 (CLAUDE.md §5). 두 앱이 같은 명세에서
# 생성한 클라이언트를 쓰는 것이 "iOS 와 Android 가 어긋나지 않게 한다" 를 지키는
# 가장 값싼 방법이기도 하다 (계획서 §1 · §5-5).
#
# library=urlsession 인 이유: 기본값인 alamofire 는 서드파티 의존성을 하나 더 끌어온다.
# 우리가 쓰는 것은 GET 여섯 개뿐이라 URLSession 으로 충분하고, 의존성이 적을수록
# Bazel 에 물릴 것도 적다.
#
# responseAs=AsyncAwait 인 이유: 화면이 SwiftUI 라 async/await 이 그대로 맞물린다.
# 기본값(콜백)은 SwiftUI 에서 쓰려면 다시 감싸야 한다.
openapi_generator(
    name = "scene_api_swift",
    additional_properties = {
        "library": "urlsession",
        "responseAs": "AsyncAwait",
        "projectName": "SceneApiClient",
        "hideGenerationTimestamp": "true",
        "useSPMFileStructure": "true",
    },
    generator = "swift5",
    spec = "scene-api-v1.yaml",
)

# 생성물을 그대로 swift_library 에 넣을 수 없다 — 소스 아닌 파일이 섞여 있고,
# 걸러서 디렉터리로 넘겨도 rules_swift 가 오브젝트 이름을 맞추지 못한다.
# 근거와 대안 비교는 merge_tree_sources.bzl 머리말에 적었다.
merge_tree_sources(
    name = "scene_api_swift_srcs",
    src = ":scene_api_swift",
    out = "SceneApiClient.swift",
    extensions = ["swift"],
    subdir = "Sources",
)

# 앱이 실제로 import 하는 모듈. scene_api_spring_lib 의 Swift 판이며 같은 일을 한다 —
# 명세에서 필드가 사라지거나 타입이 바뀌면 여기서 만들어진 타입이 바뀌고, 그것을 쓰는
# 화면 코드가 컴파일되지 않는다.
# tags = ["ios"] 가 필요하다. 리눅스에는 Swift 툴체인이 없어서 이 타깃을 지으려 하면
# rules_swift 의 linux-toolchain 해석이 실패하고 **`just gen` 과 `just build` 가 통째로
# 죽는다**(실측 — CI 우분투 잡이 네 커밋 연속 빨간불이었다). `generate.sh` 가
# `//contracts/openapi/...` 를 와일드카드로 짓기 때문에 여기까지 걸린다.
#
# 같은 태그로 apps/scenetrip-ios 를 거르고 있고(.bazelrc 의 build:linux), macOS 잡은
# 아무것도 거르지 않으므로 이 라이브러리는 verify-macos 에서 그대로 검사된다.
# Android 클라이언트(kotlin 생성기)는 리눅스에서도 지어지므로 이 태그를 달지 않는다.
swift_library(
    name = "scene_api_swift_lib",
    srcs = [":scene_api_swift_srcs"],
    module_name = "SceneApiClient",
    tags = ["ios"],
)

exports_files(["redoc-page.sh"])

# 사람이 읽는 API 레퍼런스. `just docs-api` 가 이것을 빌드해 브라우저로 연다.
#
# **생성기의 문서 기능을 쓰지 않는 이유** (실제로 넷을 다 돌려 보고 내린 결론):
#   html2      응답 스키마 창이 26 곳 중 24 곳 빈다. allOf 조합 스키마의 JSON 을 만들지
#              못해 `var schemaWrapper = ;` 라는 깨진 자바스크립트가 나온다. 화면 구조는
#              멀쩡해 보이고 내용만 비어서 알아채기 어렵다.
#   html       표는 채우지만 enum 의 허용값을 빼먹는다. Lang 이 ko·en·ja·zh-Hant 라는
#              것이 어디에도 안 나온다. 디자인도 낡았다.
#   markdown   파일 25 개로 흩어지고 enum 은 빈 표가 된다.
#   asciidoc   변환기가 따로 필요하다.
# 우리 명세는 ContentDetail·PlaceDetail 이 allOf 를 쓰고 Lang·ContentCategory 가 enum 이라
# 위 한계에 정면으로 걸린다.
#
# Redoc 은 그 둘을 제대로 그린다. 명세를 그대로 읽어 화면을 만들기 때문에 생성기의
# 중간 변환에서 정보가 떨어져 나갈 자리가 없다.
#
# 산출물은 파일 하나다. 번들과 명세를 페이지 안에 박아 넣어 네트워크도 서버도 필요
# 없다 — 왜 그래야 하는지는 redoc-page.sh 에 적었다.
#
# 생성물은 커밋하지 않는다. 명세가 바뀌면 다시 만들면 되고, 커밋하면 명세와 문서가
# 어긋난 상태가 저장소에 남는다 (contracts/README.md).
genrule(
    name = "scene_api_html",
    srcs = [
        ":scene_api_openapi_json",
        "@redoc_standalone_js//file",
    ],
    outs = ["scene_api_html/index.html"],
    cmd = "$(location redoc-page.sh) $(location @redoc_standalone_js//file) " +
          "$(location :scene_api_openapi_json)/openapi.json $@",
    tools = ["redoc-page.sh"],
)

# java_library 는 srcs 에 디렉터리를 받지 못한다. 위 규칙의 산출물은 트리 아티팩트
# (디렉터리)라서, 컴파일에 넣으려면 srcjar 로 묶어야 한다.
#
# zip 이 아니라 JDK 의 jar 를 쓰는 이유: Bazel 이 받아 온 JDK 라 호스트에 무엇이
# 깔려 있든 결과가 같다 (AGENTS.md §4.3). 호스트의 zip 에 기대면 그것이 없는 CI
# 러너에서 빌드가 깨진다 — 포매터에서 이미 한 번 겪은 실패다.
genrule(
    name = "scene_api_spring_srcjar",
    srcs = [":scene_api_spring"],
    outs = ["scene_api_spring.srcjar"],
    cmd = "$(JAVABASE)/bin/jar --create --file $@ -C $(location :scene_api_spring)/src/main/java .",
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
)

# 서블릿 API 는 컴파일에만 쓴다.
#
# 생성된 ApiUtil 이 HttpServletResponse 를 참조하는데, 실행 시에는 같은 클래스를
# tomcat-embed-core 가 이미 들고 있다. 둘 다 클래스패스에 올리면 같은 이름의 클래스가
# 두 벌이 되고, 어느 쪽이 로드되는지가 jar 순서에 좌우된다.
#
# neverlink 는 "컴파일에는 쓰되 실행 클래스패스에는 넣지 마라" 는 표시다.
java_library(
    name = "servlet_api_compile_only",
    neverlink = True,
    exports = ["@maven//:jakarta_servlet_jakarta_servlet_api"],
)

# 컨트롤러가 구현할 인터페이스와 응답 모델.
#
# **이 라이브러리가 계약을 강제하는 지점이다.** 명세에서 필드가 사라지거나 타입이
# 바뀌면 여기서 만들어진 클래스가 바뀌고, 그것을 쓰는 컨트롤러가 컴파일되지 않는다.
# 계약 테스트(//tests/contract)는 "명세가 생성기를 통과하는가" 만 보지만, 이쪽은
# "서버 코드가 그 명세와 맞는가" 를 본다.
java_library(
    name = "scene_api_spring_lib",
    srcs = [":scene_api_spring_srcjar"],
    deps = [
        ":servlet_api_compile_only",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:io_swagger_core_v3_swagger_annotations",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_web",
    ],
)

# Android 앱의 코틀린 클라이언트.
#
# **앱은 API 클라이언트를 손으로 쓰지 않는다** (CLAUDE.md §5). iOS 가 위에서 생성한
# 것을 쓰듯 Android 도 같은 계약에서 생성한 것을 쓴다 — 그래야 두 앱이 서버와
# 어긋나는 일이 계약을 고칠 때 한 번에 드러난다.
#
# library 를 jvm-okhttp4 로 두는 이유: okhttp 가 이미 앱에 들어와 있다. 네이버 지도
# SDK 의 전이 의존성이라 새 라이브러리가 아니다. retrofit2 를 고르면 그것 하나가
# 더 붙는다.
#
# serializationLibrary 를 moshi 로 두는 이유: gson 도 이미 들어와 있지만(같은 경로)
# gson 은 코틀린의 널 가능성을 모른다 — 명세가 required 로 적은 필드가 비어 와도
# non-null 프로퍼티에 null 이 들어가고, 터지는 자리는 한참 뒤다. moshi 는 코드젠으로
# 그것을 파싱 시점에 잡는다.
openapi_generator(
    name = "scene_api_kotlin",
    additional_properties = {
        "library": "jvm-okhttp4",
        "serializationLibrary": "moshi",
        "hideGenerationTimestamp": "true",
        "useTags": "true",
        "packageName": "com.mz2az.scenetrip.sceneapi.client",
    },
    api_package = "com.mz2az.scenetrip.sceneapi.client.api",
    generator = "kotlin",
    model_package = "com.mz2az.scenetrip.sceneapi.client.model",
    spec = "scene-api-v1.yaml",
)

# 생성물을 srcjar 로 감싼다.
#
# Swift 는 `merge_tree_sources` 로 **파일 하나에 합쳐서** 트리 아티팩트 문제를
# 피했다. 코틀린은 그럴 수 없다 — 파일마다 `package` 선언이 있고 한 파일에 하나만
# 올 수 있어 합치면 컴파일이 깨진다. 대신 zip 으로 묶는다 (tools/bazel/defs).
tree_srcjar(
    name = "scene_api_kotlin_srcjar",
    src = ":scene_api_kotlin",
    out = "SceneApiClient.srcjar",
    extensions = ["kt"],
    subdir = "src/main/kotlin",
)

# 컴파일된 코틀린 클라이언트. Android 앱이 이것을 deps 로 잡을 예정이다.
#
# `kt_android_library` 가 아니라 `kt_jvm_library` 인 이유: 생성 코드는 okhttp 와
# moshi 만 쓰고 안드로이드 API 를 부르지 않는다. 순수 JVM 으로 두면 나중에 서버
# 사이드나 테스트에서도 같은 클라이언트를 쓸 수 있다.
#
# srcs 에 srcjar 를 그대로 넣는다 — 코틀린 컴파일러가 소스가 든 zip 을 받아 안에서
# 꺼내 쓴다. 트리 아티팩트를 넣을 수 없어 우회한 결과다 (tools/bazel/defs).
#
# ## 지금은 `manual` 이다 — 컴파일되지 않는다
#
# **생성기의 결함이다. 우리 명세는 정상이다.**
#
# 명세가 `Lang` 에 `default: ko` 를 두는데(scene-api-v1.yaml), 생성기 7.2.0 의
# kotlin 백엔드가 그것을 **한정하지 않은 채로** 뱉는다:
#
#   fun addCartItem(..., acceptLanguage: Lang? = ko)   ← `Lang.ko` 여야 한다
#
# 그래서 `unresolved reference 'ko'` 로 40 개 파일 중 API 4 개가 깨진다. spring·
# swift5 백엔드는 같은 명세에서 멀쩡한 코드를 낸다.
#
# 고르는 길이 셋이고 **셋 다 이 파일 밖에 영향을 준다** — 그래서 정하지 않고 둔다.
#
#   1. 생성기 버전을 올린다   MODULE.bazel 의 openapi_gen 을 고치는 일이라
#                            **spring·swift5 산출물도 함께 바뀐다.** iOS 와 서버가
#                            지금 잘 돌고 있으므로 회귀 확인이 필요하다.
#   2. 생성 코드를 후처리한다  tree_srcjar 에 sed 를 한 줄 끼우면 되지만, 생성물을
#                            손보는 것은 나중에 "왜 이게 여기 있지" 가 되기 쉽다.
#   3. 명세에서 default 를 뺀다 **계약을 바꾸는 일이다.** 서버·iOS 가 함께 영향을
#                            받고, 기본 언어가 없어지는 것은 의미상으로도 손해다.
#
# 1 번이 유력하다. 게이트를 붉게 두지 않으려고 `manual` 로 빼 뒀다 — 고치는 사람이
# 이 태그를 지우는 것이 곧 완료 조건이다.
kt_jvm_library(
    name = "scene_api_kotlin_lib",
    srcs = [":scene_api_kotlin_srcjar"],
    tags = ["manual"],
    deps = [
        "@maven_android//:com_squareup_moshi_moshi",
        "@maven_android//:com_squareup_moshi_moshi_adapters",
        "@maven_android//:com_squareup_moshi_moshi_kotlin",
        "@maven_android//:com_squareup_okhttp3_okhttp",
    ],
)
