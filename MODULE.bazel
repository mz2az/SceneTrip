# SceneTrip — bzlmod 의존성 그래프.
#
# 외부 의존성을 선언하는 **유일한** 곳이다. WORKSPACE 는 쓰지 않는다.
#
# 스택은 ADR 0002 로 확정됐다: 백엔드 Spring Boot(Java) · AI Python ·
# iOS 네이티브(Swift) · Android 네이티브(Kotlin).
#
# 언어별 규칙 세트는 그 언어의 첫 모듈이 들어올 때 추가한다 — 아무도 의존하지 않는
# 규칙으로 이 파일을 채우지 않는다. 아래 주석 블록의 버전은 registry.bazel.build 에서
# 실제로 확인한 값이지만, 주석을 풀 때 한 번 더 확인하고 `just deps-update` 로
# MODULE.bazel.lock 을 갱신해 같은 커밋에 포함한다.

module(
    name = "scenetrip",
    version = "0.1.0",
    compatibility_level = 1,
)

# --- 코어 ---------------------------------------------------------------------

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# BUILD 파일 포맷·린트 (`just fmt` / `just lint` 가 사용)
bazel_dep(name = "buildifier_prebuilt", version = "6.4.0", dev_dependency = True)

# --- 계약 코드 생성 --------------------------------------------------------------
#
# contracts/openapi/ 의 명세로부터 클라이언트와 서버 인터페이스를 만든다.
# OpenAPI Generator 팀의 공식 Bazel 플러그인이며, 0.1.8 부터 bzlmod 전용이다.
#
# 헤르메틱한 이유: 생성기 본체는 자바 CLI JAR 인데 아래에서 버전과 SHA256 을 고정해
# 받는다. 같은 입력이면 같은 코드가 나온다 (AGENTS.md §4.3).
#
# 생성기 이름만 바꾸면 언어가 바뀐다 — spring(서버 인터페이스) · swift5(iOS) ·
# kotlin(Android). 앱 모듈이 들어올 때 타깃을 추가한다.
#
# 위험: 이 플러그인 저장소가 유지보수자를 구하고 있다. 하는 일이 "JAR 을 받아 실행"
# 으로 단순해서, 방치되면 tools/bazel/defs/ 에 같은 것을 직접 써도 부담은 작다.
bazel_dep(name = "openapi_tools_generator_bazel", version = "0.2.3")

openapi_gen = use_extension("@openapi_tools_generator_bazel//:extension.bzl", "openapi_gen")

# **7.2.0 에서 7.24.0 으로 올렸다.** 코틀린 백엔드가 enum 기본값을 한정하지 않고
# 뱉는 결함 때문이다 — 명세의 `Lang: default: ko` 가 `Lang? = ko` 로 나와
# `unresolved reference 'ko'` 로 컴파일이 깨졌다. 7.24.0 은 `Lang? = Lang.ko` 로
# 낸다(올리기 전에 JAR 을 직접 돌려 확인).
#
# 같은 명세로 spring·swift5 는 7.2.0 에서도 멀쩡했다. 즉 우리 명세의 문제가 아니라
# 생성기 한 백엔드의 문제였고, 그래서 명세를 고치는 대신 생성기를 올렸다.
#
# **이 값을 바꾸면 세 산출물이 모두 바뀐다** — spring 서버 인터페이스 · swift5 iOS
# 클라이언트 · kotlin Android 클라이언트. 회귀는 빌드 실패로 드러난다: 서비스 코드가
# 생성된 인터페이스를 구현하고 앱이 생성된 클라이언트를 부르므로, 시그니처가 달라지면
# `just check` 가 잡는다.
openapi_gen.client(
    sha256 = "4b83ccc6fd43056c8c631cd0195e5100bd0550912502527bab09ac76152dab0c",
    version = "7.24.0",
)
use_repo(openapi_gen, "openapi_tools_generator_bazel_cli")

# --- JVM / Java ----------------------------------------------------------------
#
# Spring Boot 백엔드 (services/), 공유 라이브러리 (libs/java/).
# 빌드 경로 결정은 ADR 0003 참고 — Bazel 이 실행 가능 jar 를 만들고 컨테이너에는
# 그 산출물만 담는다. Gradle·Maven 을 빌드 경로로 쓰지 않는다.
#
# rules_spring 이 필요한 이유: java_binary 의 deploy jar 는 같은 경로의 리소스를
# 첫 번째 것만 남기고 버리는데, Spring 은 여러 jar 에 흩어진 자동 구성 목록
# (META-INF/spring/…AutoConfiguration.imports)이 **합쳐져야** 동작한다. 그대로 두면
# 앱은 뜨지만 자동 구성이 조용히 반만 걸린다.
bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_spring", version = "2.6.3")

# --- OpenTelemetry 자바 에이전트 ------------------------------------------------
#
# 코드를 고치지 않고 트레이스·메트릭·로그를 내보내게 하는 javaagent 다. Spring MVC·
# JDBC·HikariCP·Logback 을 자동으로 계측한다 (ADR 0004).
#
# **Dockerfile 에서 curl 로 받지 않는다.** 설치 가이드에는 그렇게 적혀 있었지만 두 가지가
# 걸린다 — 이미지 빌드 때 네트워크를 타고, 받은 파일이 우리가 기대한 것인지 확인하지
# 않는다. Bazel 이 받으면 sha256 이 맞지 않을 때 빌드가 실패하고, 버전이 이 파일 한
# 곳에만 적힌다. ADR 0003 의 "Bazel 이 산출물을 만들고 도커는 담기만 한다" 와도 맞는다.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "otel_javaagent",
    downloaded_file_path = "opentelemetry-javaagent.jar",
    sha256 = "9d6bc2ad8dd8fb7f730984988e57b8ac0a82d81c7b3b8ae795378718733a509d",
    urls = ["https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.30.0/opentelemetry-javaagent.jar"],
)

# --- API 문서 렌더러 ------------------------------------------------------------
#
# 명세를 사람이 읽는 화면으로 그리는 자바스크립트다. `just docs-api` 가 이것과 명세를
# 합쳐 혼자 열리는 HTML 한 장을 만든다 (contracts/openapi/BUILD.bazel).
#
# **왜 생성기의 문서 기능을 안 쓰는가.** OpenAPI Generator 7.2.0 의 html2 는 응답 스키마
# 창이 26 곳 중 24 곳 비어 나오고(allOf 조합 스키마를 JSON 으로 만들지 못한다), html 은
# 표는 채우지만 enum 의 허용값을 빼먹는다. 우리 명세는 ContentDetail·PlaceDetail 이
# allOf 를 쓰고 Lang·ContentCategory 가 enum 이라 둘 다 정면으로 걸린다.
#
# **왜 CDN 을 걸지 않는가.** 문서를 열 때마다 네트워크를 타면 비행기 안에서도, 사내망
# 에서도 빈 화면이 된다. 여기서 받아 파일에 박아 넣으면 그런 일이 없다. sha256 을
# 고정하므로 받은 것이 우리가 기대한 것인지도 확인된다 — otel 에이전트와 같은 방식이다.
#
# 버전을 latest 가 아니라 v2.5.0 으로 박은 이유: latest 는 내용이 바뀌는 URL 이라
# sha256 이 어느 날 갑자기 어긋나 빌드가 깨진다.
http_file(
    name = "redoc_standalone_js",
    downloaded_file_path = "redoc.standalone.js",
    sha256 = "0ec05be285ac885a330289b02f470e1bdbd2b6b3223a9fa213f24bf805a851d1",
    urls = ["https://cdn.redoc.ly/redoc/v2.5.0/bundles/redoc.standalone.js"],
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "org.springframework.boot:spring-boot-starter-web:4.1.0",
        "org.springframework.boot:spring-boot-starter-actuator:4.1.0",
        "org.springframework.boot:spring-boot-starter-test:4.1.0",
        # @WebMvcTest 는 starter-test 에 없다. Spring Boot 4 는 자동 구성뿐 아니라
        # **테스트 슬라이스도** 기술별 모듈로 쪼갰다 — Flyway 때와 같은 패턴이다.
        # 컨트롤러를 DB 없이 HTTP 계층만 띄워 검사하는 데 쓴다.
        "org.springframework.boot:spring-boot-webmvc-test:4.1.0",
        # 실행 가능 jar 의 부트스트랩 클래스. jar 루트에 풀려 들어가고
        # MANIFEST 의 Main-Class 가 이것을 가리킨다. 없으면 jar 가 실행되지 않는다.
        "org.springframework.boot:spring-boot-loader:4.1.0",

        # DB. 버전은 전부 spring-boot-dependencies:4.1.0 이 관리하는 값과 맞췄다 —
        # Spring 의 자동 구성은 특정 Flyway·드라이버 버전대를 전제하고 짜여 있어서,
        # 최신판으로 올려 두면 "빈은 생겼는데 마이그레이션이 안 돈다" 같은 조용한
        # 어긋남이 난다. 여기는 BOM 이 아니라 손으로 고정하는 자리이므로 명시한다.
        #
        # 아티팩트가 셋이나 되는 이유가 있다. 둘 다 빠뜨려 봤고 증상이 서로 다르다.
        #
        #   spring-boot-starter-flyway    Boot 4 는 자동 구성을 기술별 모듈로 쪼갰다.
        #                                 FlywayAutoConfiguration 은 spring-boot-flyway
        #                                 에 있고 이 스타터가 그것을 끌어온다. 없으면
        #                                 **오류 없이 마이그레이션이 그냥 안 돈다** —
        #                                 앱은 뜨고 헬스체크도 초록이다 (실측).
        #   flyway-database-postgresql    Flyway 10 부터 DB 별 지원이 코어에서 떨어져
        #                                 나갔다. 없으면 "no database provider" 로 죽는다.
        #   flyway-core                   엔진. 스타터가 끌어오지만 버전을 여기서 고정한다.
        "org.springframework.boot:spring-boot-starter-jdbc:4.1.0",
        "org.springframework.boot:spring-boot-starter-flyway:4.1.0",

        # 명세에서 생성한 Spring 인터페이스를 컴파일하는 데 필요한 것들.
        # 컨트롤러가 그 인터페이스를 구현하므로 계약 위반이 컴파일 오류가 된다
        # (contracts/openapi/BUILD.bazel).
        #
        # starter-validation 은 컴파일이 아니라 **실행**을 위해 필요하다.
        # jakarta.validation-api 는 @Size·@Min 같은 표식만 정의하고, 그것을 실제로
        # 검사하는 구현(hibernate-validator)은 별도다. 없으면 표식이 붙어 있는데도
        # 아무 검사가 일어나지 않아, 명세가 400 을 약속한 요청이 그대로 통과한다.
        "org.springframework.boot:spring-boot-starter-validation:4.1.0",
        "jakarta.validation:jakarta.validation-api:3.1.1",
        "jakarta.annotation:jakarta.annotation-api:3.0.0",
        "jakarta.servlet:jakarta.servlet-api:6.1.0",
        # 생성 코드가 @Operation·@Schema 로 명세를 코드에 다시 적어 둔다. 우리가 읽는
        # 것은 아니지만 없으면 컴파일이 안 된다.
        "io.swagger.core.v3:swagger-annotations:2.2.53",

        # OpenTelemetry API. 오류 응답의 traceId 를 읽는 데만 쓴다.
        #
        # **API 만이다. SDK 는 넣지 않는다** — 계측과 내보내기는 자바 에이전트가
        # 한다(ADR 0004). 에이전트가 이 API 호출을 자기 SDK 로 이어 주고, 에이전트가
        # 없으면 아무것도 하지 않는 빈 구현이 답한다. 그래서 단위 테스트와 수집기 없는
        # 로컬 실행에서도 코드가 그대로 돈다.
        #
        # 버전은 에이전트 2.30.0 이 담고 있는 것과 맞췄다 (에이전트 2.X ↔ API 1.(X+26)).
        # API 가 에이전트보다 새로우면 에이전트가 이어 주지 못한다.
        "io.opentelemetry:opentelemetry-api:1.56.0",
        "org.flywaydb:flyway-core:12.4.0",
        "org.flywaydb:flyway-database-postgresql:12.4.0",
        "org.postgresql:postgresql:42.7.11",

        # Java 포매터·린터. 호스트에 깔지 않고 Bazel 이 받아 //:google_java_format ·
        # //:checkstyle 로 실행한다 — buildifier 와 같은 방식이다.
        #
        # 호스트 설치에 의존하면 두 가지가 깨진다. AGENTS.md §4.3 의 "깔려 있는 것에
        # 의존하지 않는다" 를 어기고, 더 실질적으로는 **사람마다 도구 버전이 달라져
        # 포맷 결과가 갈린다.** 실제로 CI 러너에 도구가 없어 빌드가 실패했다.
        "com.google.googlejavaformat:google-java-format:1.36.1",
        "com.puppycrawl.tools:checkstyle:13.9.0",
        # Bazel 의 java_test 는 JUnit4 러너를 기본으로 쓴다. Spring Boot 가 가져오는
        # 것은 JUnit5(Jupiter)이므로 그것을 실행할 콘솔 런처가 따로 필요하다.
        # tools/bazel/defs/java_junit5_test.bzl 이 이 의존성을 쓴다.
        "org.junit.platform:junit-platform-console:6.0.3",
    ],
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")

# --- Swift / iOS ----------------------------------------------------------------
#
# iOS 앱 (apps/<name>-ios/), 공유 라이브러리 (libs/swift/). 첫 iOS 모듈
# (apps/scenetrip-ios)과 함께 활성화했다 — docs/project/plans/mobile-native-search-tab.md §5-1.
#
# Xcode 자체는 Bazel 이 받아올 수 없다 (Apple 라이선스상 재배포 금지). apple_support
# 를 선언한 순간부터 macOS 에서는 iOS 타깃 유무와 무관하게 모든 로컬 액션 전에
# Xcode 버전 확인이 돌므로, **빌드에 참여하는 모든 macOS 장비에 정식 Xcode 가
# 필요하다.** Command Line Tools 만 있으면 저장소 전체 빌드가 FATAL 크래시로
# 죽는다(DottedVersion 파싱 실패 — 실측 확인). 팀 전원 설치는 2026-08-06 확인됐다.
# AGENTS.md §4.3 "no host toolchains" 원칙에 대한 유일한 예외다.
#
# iOS 빌드/테스트는 macOS 실행기에서만 돈다 (Linux 원격 실행 불가). iOS 타깃에는
# target_compatible_with = ["@platforms//os:macos"] 를 선언해 리눅스 러너가
# 건너뛰게 한다 — 같은 계획서 §5-3.
bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_apple", version = "4.5.3")

# 1.x 가 필요하다. 주석으로 대기하던 0.34.0 은 SPM 의 **binaryTarget 을 Bazel 규칙으로
# 옮기지 못한다** — pkg_info.json 에 xcframework 다운로드 URL 까지 읽어 두고도
# `:<이름>.rspm` 타깃을 만들지 않아 "target does not exist" 로 분석이 깨진다(실측).
# 네이버 지도 SDK 가 바로 그 형태(binaryTarget 래퍼)라 정면으로 걸린다.
bazel_dep(name = "rules_swift_package_manager", version = "1.23.0")  # 서드파티 SPM 의존성

bazel_dep(name = "rules_xcodeproj", version = "2.10.0", dev_dependency = True)  # IDE 용 .xcodeproj 생성

# --- Kotlin / Android -----------------------------------------------------------
#
# Android 앱 (apps/<name>-android/), 공유 라이브러리 (libs/kotlin/).
#
# **Android SDK 는 Bazel 이 받아오지 못한다.** Xcode 와 같은 종류의 예외지만 정도가
# 가볍다 — 애플과 달리 재배포가 막혀 있지 않아 버전 고정은 되고, GUI 프로그램
# (Android Studio)도 필요 없다. 설치 절차는 docs/engineering/onboarding.md 에 있고
# 빠졌는지는 `just doctor` 가 본다.
#
# SDK 경로는 기계마다 달라 `.env` 의 ANDROID_HOME 으로 넘긴다. rules_android 가
# 그 환경변수를 읽는다.
#
# iOS 와 달리 **CI 에 새 잡이 필요 없다.** Android 는 리눅스에서 지어지므로 기존
# ubuntu `verify` 잡이 그대로 검사한다 — 계획서 §5-2.
bazel_dep(name = "rules_kotlin", version = "2.4.0")
bazel_dep(name = "rules_android", version = "0.7.3")

# SDK 저장소는 `bazel_dep` 만으로 생기지 않는다. 확장을 등록해야 `@androidsdk` 가
# 잡힌다 — 등록 전에는 "No repository visible as '@androidsdk'" 로 죽는다(실측).
#
# **`path` 를 적지 않는다.** 비워 두면 확장이 `ANDROID_HOME` 환경변수를 읽는다.
# 경로를 여기 박으면 brew 로 깐 사람과 Android Studio 로 깐 사람이 갈린다
# (`/opt/homebrew/share/…` vs `~/Library/Android/sdk`). 값은 `.env` 에서 온다.
#
# api_level·build_tools_version 은 고정한다. 이것이 Xcode 와 다른 점이다 — SDK 를
# 받아오지는 못해도 **어느 버전을 쓸지는 저장소가 정한다.** 사람마다 다른 버전으로
# 지으면 산출물이 갈린다 (AGENTS.md §4.3).
#
# 36 / 36.1.0 을 고른 이유: 둘 다 안정판이다. build-tools 37.0.0 도 나와 있으나
# rules_android 0.7.3 과의 호환을 확인하지 않았다.
android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(
    api_level = 36,
    build_tools_version = "36.1.0",
)
use_repo(android_sdk_repository_extension, "androidsdk")

# 네이버 지도 Android SDK.
#
# **백엔드의 `@maven` 과 저장소를 나눈다.** 같은 install 에 넣으면 Spring 서비스의
# 잠금파일에 안드로이드 UI 라이브러리가 섞이고, 한쪽을 갱신할 때 다른 쪽이 함께
# 흔들린다. 서비스와 앱은 서로의 내부를 모른다는 원칙(CLAUDE.md §5)과도 맞는다.
#
# 저장소가 셋인 이유:
#   repo1        okhttp · gson 등 일반 자바 라이브러리
#   maven.google androidx (appcompat · recyclerview · swiperefreshlayout)
#   naver        map-sdk 본체. 여기에만 있다
#
# 버전 3.23.3 은 **iOS 와 같은 값이다** (Package.resolved 의 spm-nmapsmap 3.23.3).
# 두 앱이 다른 SDK 버전을 쓰면 지도 동작이 갈리고, ADR 0002 가 네이티브 두 벌을
# 택하며 스스로 건 검증 항목("두 앱이 어긋나지 않는가")에 정면으로 걸린다.
maven_android = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

#
# **체크섬 검증을 끈다.** 네이버 저장소는 `.sha1`·`.md5` 를 아예 서빙하지 않는다
# (pom 은 200, pom.sha1 은 404 — 직접 확인). 기본값 그대로면 Coursier 가
# "checksum errors: SHA-1: not found" 로 해석을 거부한다.
#
# 무결성이 사라지는 것은 아니다. rules_jvm_external 이 내려받은 파일의 sha256 을
# **직접 계산해 잠금파일에 적는다.** 즉 첫 해석 시점의 바이트가 고정되고, 이후
# 누군가 저장소의 파일을 바꾸면 빌드가 깨진다. 저장소가 주는 체크섬을 믿는 대신
# 우리가 받은 것을 기준으로 삼는 셈이다 — otel 에이전트를 sha256 으로 박아 둔 것과
# 같은 방식이고, 오히려 그쪽에 가깝다.
maven_android.install(
    name = "maven_android",
    artifacts = [
        # aar 이다. rules_jvm_external 이 aar_import 타깃을 만들어 준다.
        # 이 하나가 androidx.appcompat · recyclerview · swiperefreshlayout ·
        # okhttp · gson · relinker · naver geometry 를 함께 끌어온다(POM 확인).
        "com.naver.maps:map-sdk:3.23.3",

        # 아래는 map-sdk 가 직접 부르지 않는다. **androidx 전이 의존성의 충돌을 푸는
        # 못**이다. appcompat 1.7.0 이 끌어오는 fragment·activity·lifecycle 이 서로
        # 다른 버전을 요구하고, 일부는 `[1.2.0]` 같은 고정 범위라 해석기가 고르지
        # 못하고 "Conflicting dependencies" 로 멈춘다(실측).
        #
        # 각 계열에서 가장 높은 요구 버전으로 맞춘다. version_conflict_policy 를
        # "pinned" 로 두면 여기 적은 값이 이긴다.
        #
        # **lifecycle 이 2.6.2 에서 2.8.7 로 올라갔다.** Compose 를 붙이면서다 —
        # activity-compose 1.11.0 과 lifecycle-runtime-compose 가 2.8 계열을 요구해
        # 2.6.2 로 못을 박아 두면 해석이 다시 막힌다. 지도 SDK 는 더 높은 버전에서도
        # 그대로 뜬다(에뮬레이터 확인).
        "androidx.emoji2:emoji2:1.3.0",
        "androidx.emoji2:emoji2-views-helper:1.3.0",
        "androidx.lifecycle:lifecycle-common:2.8.7",
        "androidx.lifecycle:lifecycle-livedata-core:2.8.7",
        "androidx.lifecycle:lifecycle-runtime:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-savedstate:2.8.7",

        # --- Jetpack Compose -------------------------------------------------
        #
        # 검색 탭을 코틀린으로 옮기면서 들어왔다. **SwiftUI 와 같은 선언형**이라
        # iOS 코드가 구조를 유지한 채 옮겨진다 — `@State` → `remember`,
        # `VStack` → `Column`. View + XML 로 가면 같은 화면에 RecyclerView·Adapter·
        # ViewHolder·DiffUtil 이 붙어 코드가 두세 배가 되고, 그만큼 두 앱의 구조가
        # 갈려 "iOS 와 같은 규칙" 을 지키기 어려워진다.
        #
        # **왜 이렇게 길게 적나.** Compose 아티팩트는 멀티플랫폼이라 이름 하나가
        # 둘이다 — `ui` 는 껍데기이고 실제 코드는 `ui-android` 에 있다. 그런데
        # material3 1.4.0 은 `foundation-android:1.8.1` 을, material-ripple 은
        # `foundation-android:1.7.1` 을 요구한다. 껍데기만 못 박으면 **짝 아티팩트의
        # 버전이 안 정해져** "Conflicting dependencies" 로 해석이 멈춘다(실측).
        # version_conflict_policy = "pinned" 는 **여기 적힌 것만** 이기게 해 주므로,
        # 충돌하는 짝을 하나도 빼놓지 않고 적어야 한다.
        #
        # 본체는 **1.7.8**, material3 는 **1.3.2** 로 통일한다. 둘이 같은 시기에 나온
        # 짝이라 서로에게 요구하는 판이 어긋나지 않는다. 1.8/1.9 로 올려 봤더니
        # material3 만 판이 앞서 나가 `foundation-android` 를 세 버전이 서로 다르게
        # 요구했다(실측). 올릴 때는 **이 블록 전체를 같은 시기의 짝으로 함께** 올린다.
        #
        # **컴파일러 플러그인은 여기 없다.** Kotlin 2.x 부터 Compose 컴파일러가
        # Kotlin 배포에 함께 들어와 버전이 Kotlin 과 같아야 한다 — 아래 별도 절.
        "androidx.compose.runtime:runtime:1.7.8",
        "androidx.compose.runtime:runtime-android:1.7.8",
        "androidx.compose.foundation:foundation:1.7.8",
        "androidx.compose.foundation:foundation-android:1.7.8",
        "androidx.compose.foundation:foundation-layout:1.7.8",
        "androidx.compose.foundation:foundation-layout-android:1.7.8",
        "androidx.compose.animation:animation:1.7.8",
        "androidx.compose.animation:animation-android:1.7.8",
        "androidx.compose.animation:animation-core:1.7.8",
        "androidx.compose.animation:animation-core-android:1.7.8",
        "androidx.compose.ui:ui:1.7.8",
        "androidx.compose.ui:ui-android:1.7.8",
        "androidx.compose.ui:ui-geometry:1.7.8",
        "androidx.compose.ui:ui-geometry-android:1.7.8",
        "androidx.compose.ui:ui-graphics:1.7.8",
        "androidx.compose.ui:ui-graphics-android:1.7.8",
        "androidx.compose.ui:ui-text:1.7.8",
        "androidx.compose.ui:ui-text-android:1.7.8",
        "androidx.compose.ui:ui-unit:1.7.8",
        "androidx.compose.ui:ui-unit-android:1.7.8",
        "androidx.compose.ui:ui-util:1.7.8",
        "androidx.compose.ui:ui-util-android:1.7.8",
        "androidx.compose.material:material-icons-core:1.7.8",
        "androidx.compose.material:material-icons-core-android:1.7.8",
        "androidx.compose.material:material-ripple:1.7.8",
        "androidx.compose.material:material-ripple-android:1.7.8",
        "androidx.compose.material3:material3:1.3.2",
        "androidx.compose.material3:material3-android:1.3.2",

        # **activity 세 개를 같은 버전으로 묶는다.** 이것이 Compose 를 붙이며 가장
        # 오래 막힌 지점이다. `activity-ktx` 의 pom 은 `activity` 를 `[1.9.3]` 같은
        # **하드 범위**로 못 박는데, 하드 범위는 version_conflict_policy 로 이길 수
        # 없다. compose ui-android 가 activity-ktx 1.7.0 을 끌고 오고
        # activity-compose 가 더 높은 판을 하드로 요구하면, 서로 다른 하드 범위 둘이
        # 남아 "Conflicting dependencies" 로 해석이 멈춘다(실측).
        #
        # 셋을 같은 값으로 적으면 하드 범위도 하나로 모인다.
        # 같은 이유로 `-ktx` 계열을 본체와 짝지어 못 박는다. `collection-ktx:1.2.0`
        # 하나가 `collection` 을 `[1.2.0]` 으로 잡고 있는 동안 compose 쪽은 1.4.0 을
        # 원해서 같은 방식으로 막혔다. **`-ktx` 를 볼 때마다 본체도 같이 적는다** 가
        # 여기서 배운 규칙이다.
        "androidx.activity:activity:1.9.3",
        "androidx.activity:activity-ktx:1.9.3",
        "androidx.activity:activity-compose:1.9.3",
        "androidx.collection:collection:1.4.0",
        "androidx.collection:collection-jvm:1.4.0",
        "androidx.collection:collection-ktx:1.4.0",
        "androidx.core:core:1.13.1",
        "androidx.core:core-ktx:1.13.1",
        "androidx.fragment:fragment:1.8.5",
        "androidx.fragment:fragment-ktx:1.8.5",
        "androidx.savedstate:savedstate:1.2.1",
        "androidx.savedstate:savedstate-ktx:1.2.1",
        "androidx.lifecycle:lifecycle-livedata-core-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-runtime-compose:2.8.7",
        "androidx.lifecycle:lifecycle-runtime-compose-android:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-compose-android:2.8.7",

        # 코루틴. Compose 화면이 서버 호출을 기다리는 데 쓴다 — 생성된 클라이언트가
        # 블로킹 호출이라 IO 디스패처로 옮겨야 하고, 그것이 코루틴의 몫이다.
        # rules_kotlin 은 stdlib 만 들고 오지 코루틴은 주지 않는다.
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm:1.10.2",

        # 생성된 코틀린 API 클라이언트가 쓰는 것. **우리가 고른 것이 아니라
        # 생성기가 내놓은 코드가 부르는 것**이라, 생성기 설정(library·
        # serializationLibrary)을 바꾸면 이 셋도 함께 바뀐다.
        #
        # okhttp 는 이미 네이버 지도 SDK 의 전이 의존성으로 들어와 있다. 새로 붙는
        # 것은 moshi 쪽뿐이고, gson 대신 moshi 를 고른 이유는 계약 BUILD 에 적었다.
        "com.squareup.moshi:moshi:1.15.2",
        "com.squareup.moshi:moshi-adapters:1.15.2",
        "com.squareup.moshi:moshi-kotlin:1.15.2",
        "com.squareup.okhttp3:okhttp:4.12.0",

        # Compose 컴파일러 플러그인. **버전이 Kotlin 컴파일러와 같아야 한다.**
        # rules_kotlin 2.4.0 이 Kotlin 2.4.0 을 들고 오므로 2.4.0 이다
        # (rules_kotlin 의 versions.bzl · KOTLIN_CURRENT_COMPILER_RELEASE).
        # rules_kotlin 을 올릴 때 이 줄을 함께 올리지 않으면 컴파일러가 플러그인을
        # 거부한다.
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.4.0",
    ],
    fail_on_missing_checksum = False,
    lock_file = "//:maven_android_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
        "https://repository.map.naver.com/archive/maven",
    ],
    version_conflict_policy = "pinned",
)
use_repo(maven_android, "maven_android")

# 서드파티 Swift 의존성은 //:Package.swift 에 선언하고 여기서 Bazel 저장소로 바꾼다.
# maven 절과 같은 규약이다 — 선언은 매니페스트에, 잠금은 커밋된 resolved 파일에.
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_spm_nmapsmap")

# --- BUILD 파일 생성 ------------------------------------------------------------
# 지금은 생성기를 두지 않는다. BUILD.bazel 은 손으로 쓴다 — AGENTS.md §4.1 의 이름
# 규칙을 지키면 라벨은 여전히 예측 가능하다.
#
# 흔히 쓰는 Gazelle 은 Go·proto 만 내장이고 다른 언어는 **언어별 확장을 따로 붙이는**
# 구조다. 확장 자체는 존재하므로 "쓸 수 없다"가 아니라 "지금 붙일 때가 아니다" 다:
#
#   - 저장소에 모듈이 아직 0 개다. 생성해 줄 BUILD 파일 자체가 없다.
#   - 확장은 언어마다 별도 bazel_dep 과 설정이 필요하다. 넷을 다 붙이면 관리 대상이
#     그만큼 늘어난다.
#   - gazelle 바이너리가 Go 로 구현돼 있어 rules_go 를 함께 끌고 온다(저장소에 Go
#     코드가 있다는 뜻은 아니다). 얻는 것 없이 Go 툴체인을 내려받게 된다.
#   - **Android 는 아예 답이 없다.** 아래 표 참고.
#
# 첫 모듈이 들어올 때 그 언어의 확장만 골라 붙인다:
#
#   Java   bazel-contrib/rules_jvm 의 java/gazelle
#          (java_library·java_binary·java_test·java_test_suite 생성)
#   Swift  cgrindel/rules_swift_package_manager 의 swift_gazelle_plugin
#          (swift_library·swift_binary·swift_test 생성) — 아래 Swift 블록의
#          rules_swift_package_manager 가 바로 이것을 품고 있다
#   Python rules_python_gazelle_plugin
#   Kotlin **없다고 보는 게 맞다.** Aspect 의 kotlin 플러그인은 스스로 EXPERIMENTAL
#          ("not yet ready for use")이라 밝히고 있고, 생성 대상도 kt_jvm_library /
#          kt_jvm_binary 뿐이다. 우리 Kotlin 용도는 Android 앱이라 정작 필요한
#          android_library·android_binary·kt_android_library 를 만들어 주지 못한다.
#          Gazelle 에 Android 확장은 공식·비공식 모두 사실상 없다.

# ==============================================================================
# 아래 블록은 해당 언어의 첫 모듈이 들어올 때 주석을 푼다.
# ==============================================================================
#
# JVM / Java — **위 "JVM / Java" 절에서 이미 활성화됐다.** 첫 서비스(scene-api)와
# 함께 풀었고, 패키징 방식은 ADR 0003 으로 확정했다.
#
# Kotlin — **아래 "Kotlin / Android" 절에서 이미 활성화됐다.** 첫 Android 앱과 함께
# 풀었다. 팀원 SDK 설치는 `just doctor` 가 확인한다.
#
# Swift — **위 "Swift / iOS" 절에서 이미 활성화됐다.** 첫 iOS 앱(scenetrip-ios)과
# 함께 풀었고, 팀 전원 정식 Xcode 설치를 확인한 뒤였다.
#
# Python — AI 에이전트 (agents/), 공유 라이브러리 (libs/python/):
#   bazel_dep(name = "rules_python", version = "2.2.0")
#   pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
#   pip.parse(hub_name = "pypi", python_version = "3.12",
#             requirements_lock = "//:requirements.lock")
#   use_repo(pip, "pypi")
#
# Protobuf / gRPC (contracts/proto):
#   bazel_dep(name = "protobuf", version = "27.3")
#   bazel_dep(name = "rules_proto", version = "6.0.2")
#
# 컨테이너 이미지 (services/ 의 :image / :push 타깃 — apps/ 모바일 모듈에는 해당 없음,
# 대신 :ipa / :aab 설치 산출물을 만든다):
#   bazel_dep(name = "rules_oci", version = "2.0.1")
#   bazel_dep(name = "container_structure_test", version = "1.16.0")
