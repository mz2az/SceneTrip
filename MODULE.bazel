# SceneTrip — bzlmod 의존성 그래프.
#
# 외부 의존성을 선언하는 **유일한** 곳이다. WORKSPACE 는 쓰지 않는다.
#
# 주의: 아래 버전은 출발점이다. 첫 빌드 전에 https://registry.bazel.build 에서
# 각각을 확인하고 `just deps-update` 로 MODULE.bazel.lock 을 만들어 커밋한다.
#
# 언어별 규칙 세트는 그 언어의 첫 모듈이 들어올 때 추가한다 — 아무도 의존하지 않는
# 규칙으로 이 파일을 채우지 않는다.

module(
    name = "scenetrip",
    version = "0.1.0",
    compatibility_level = 1,
)

# --- 코어 ---------------------------------------------------------------------

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# BUILD 파일 포맷·린트 (`just fmt` / `just lint` 가 사용)
bazel_dep(name = "buildifier_prebuilt", version = "6.4.0", dev_dependency = True)

# --- BUILD 파일 생성 ------------------------------------------------------------
# Gazelle 이 `just gen` 을 구동한다. gazelle 바이너리 자체가 Go 로 구현돼 있어
# rules_go 를 필요로 한다 — 이 저장소에 Go 애플리케이션 코드가 있다는 뜻이 아니다.
# 실제로 이 두 의존성은 오직 Gazelle 툴체인용이다. 참고로 Gazelle 의 언어 지원은
# Go 기준으로 가장 성숙하며 JVM/Swift/Kotlin 은 커버하지 않는다 — 아래 언어들의
# BUILD.bazel 은 당분간 손으로 관리한다 (AGENTS.md §4.5 참고).

bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.39.1")

# ==============================================================================
# 아래 블록은 해당 언어의 첫 모듈이 들어올 때 추가한다.
# 그 시점에 registry.bazel.build 에서 버전을 확인할 것.
# ==============================================================================
#
# JVM / Java — Spring Boot 백엔드 (services/), 공유 라이브러리 (libs/java/):
#   bazel_dep(name = "rules_java", version = "8.5.1")
#   bazel_dep(name = "rules_jvm_external", version = "6.3")
#   maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
#   maven.install(name = "maven", artifacts = [...], lock_file = "//:maven_install.json")
#   use_repo(maven, "maven")
#   # Spring Boot 실행 가능 jar 패키징은 rules_java 만으로는 안 된다. 커뮤니티 규칙
#   # (예: salesforce/rules_spring) 또는 tools/bazel/defs/ 의 자체 매크로가 필요하다 —
#   # 첫 서비스가 들어올 때 결정한다.
#
# Kotlin — Android 앱 (apps/<name>-android/), 공유 라이브러리 (libs/kotlin/):
#   bazel_dep(name = "rules_kotlin", version = "1.9.6")
#   bazel_dep(name = "rules_android", version = "0.6.0")
#   # 로컬/CI 에 Android SDK 가 설치돼 있어야 한다 (rules_android 의 SDK extension 으로
#   # 버전 고정 가능 — 완전 격리는 아니지만 Xcode보다는 재현성이 좋다).
#
# Swift — iOS 앱 (apps/<name>-ios/), 공유 라이브러리 (libs/swift/):
#   bazel_dep(name = "rules_apple", version = "3.16.0")
#   bazel_dep(name = "rules_swift", version = "2.3.1")
#   bazel_dep(name = "rules_swift_package_manager", version = "0.34.0")  # 서드파티 SPM 의존성
#   bazel_dep(name = "rules_xcodeproj", version = "2.10.0", dev_dependency = True)  # IDE 용 .xcodeproj 생성
#   # 주의: Xcode 자체는 Bazel 이 받아올 수 없다 (Apple 라이선스상 재배포 금지).
#   # 빌드/CI 머신마다 tools/bazel/toolchains/ 에 고정한 버전의 Xcode 가 실제로 설치돼
#   # 있어야 한다 — AGENTS.md §4.3 의 "no host toolchains" 원칙에 대한 유일한 예외.
#   # iOS 빌드/테스트는 macOS 실행기에서만 돈다 (Linux 원격 실행 불가).
#
# Python — AI 에이전트 (agents/), 공유 라이브러리 (libs/python/):
#   bazel_dep(name = "rules_python", version = "0.36.0")
#   pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
#   pip.parse(hub_name = "pypi", python_version = "3.12",
#             requirements_lock = "//:requirements.lock")
#   use_repo(pip, "pypi")
#
# Protobuf / gRPC (contracts/proto):
#   bazel_dep(name = "protobuf", version = "27.3")
#   bazel_dep(name = "rules_proto", version = "6.0.2")
#
# 컨테이너 이미지 (services/ 의 :image / :push 타깃 — apps/ 모바일 모듈에는 해당 없음,
# 대신 :ipa / :aab 설치 산출물을 만든다):
#   bazel_dep(name = "rules_oci", version = "2.0.1")
#   bazel_dep(name = "container_structure_test", version = "1.16.0")
