# SceneTrip — bzlmod 의존성 그래프.
#
# 외부 의존성을 선언하는 **유일한** 곳이다. WORKSPACE 는 쓰지 않는다.
#
# 주의: 아래 버전은 출발점이다. 첫 빌드 전에 https://registry.bazel.build 에서
# 각각을 확인하고 `just deps-update` 로 MODULE.bazel.lock 을 만들어 커밋한다.
#
# 언어별 규칙 세트는 그 언어의 첫 모듈이 들어올 때 추가한다 — 아무도 의존하지 않는
# 규칙으로 이 파일을 채우지 않는다.

module(
    name = "scenetrip",
    version = "0.1.0",
    compatibility_level = 1,
)

# --- 코어 ---------------------------------------------------------------------

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# BUILD 파일 포맷·린트 (`just fmt` / `just lint` 가 사용)
bazel_dep(name = "buildifier_prebuilt", version = "6.4.0", dev_dependency = True)

# --- BUILD 파일 생성 ------------------------------------------------------------
# Gazelle 이 `just gen` 을 구동한다. 첫 Go 모듈이 생기기 전에도 gazelle 자체가
# rules_go 를 필요로 한다.

bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.39.1")

