# --- Bazel --------------------------------------------------------------------
/bazel-*
.bazelrc.user
user.bazelrc

# --- 시크릿 (절대 커밋 금지. .env.example 은 커밋한다) --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json
kubeconfig
kubeconfig.*

# --- 언어별 산출물 (진짜 결과물은 Bazel 이 소유. 아래는 IDE·도구 찌꺼기) ---------
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.tsbuildinfo

# --- 도구 캐시 -----------------------------------------------------------------
.cache/
coverage/
*.lcov
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- terraform -----------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- 에디터 / OS ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- 로컬 임시 파일 -------------------------------------------------------------
/tmp/
/scratch/
*.local.*
