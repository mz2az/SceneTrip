# --- Bazel --------------------------------------------------------------------
/bazel-*
.bazelrc.user
user.bazelrc

# --- 시크릿 (절대 커밋 금지. .env.example 은 커밋한다) --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json
kubeconfig
kubeconfig.*

# --- 언어별 산출물 (진짜 결과물은 Bazel 이 소유. 아래는 IDE·도구 찌꺼기) ---------
# Python (agents/, libs/python/)
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/

# Java / Kotlin (services/, apps/ Android) — Gradle·IntelliJ 가 남기는 찌꺼기
.gradle/
!gradle/wrapper/gradle-wrapper.jar
local.properties
*.iml
*.hprof
captures/

# Android
*.apk
*.aab
*.dex
.cxx/

# Swift / Xcode (apps/ iOS)
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscmblueprint
*.moved-aside
.swiftpm/
Pods/

# --- 도구 캐시 -----------------------------------------------------------------
.cache/
coverage/
*.lcov
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- terraform -----------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- 에디터 / OS ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
# settings.json 은 커밋하지 않는다. `just ide` 가 만드는 파일이고, 그 안의 jar 경로에
# Bazel output_base 가 들어간다 — 사용자 이름과 워크스페이스 해시로 만들어져 기계마다
# 다르다. 커밋하면 그것을 만든 사람 말고는 전부 없는 경로를 가리키게 된다.
# 저장소를 처음 받은 사람은 `just ide` 를 한 번 실행하면 된다.
!.vscode/extensions.json

# --- 로컬 임시 파일 -------------------------------------------------------------
/tmp/
/scratch/
*.local.*

# Swift Package Manager 작업 디렉터리 (해석 결과는 Package.resolved 로 커밋한다)
.build/

# Xcode 프로젝트는 생성물이다 — `just ios-xcode` 가 만든다. 사람마다 서명 설정과
# 기기 목록이 달라 커밋하면 서로 덮어쓴다. 정본은 BUILD.bazel 의 xcodeproj 타깃이다.
*.xcodeproj/
*.xcworkspace/

# navi-proto 전용 브랜치의 모듈 — main 에는 없다(MZ2AZ-293 결정). 브랜치를
# 오가는 로컬의 잔여물(데이터·venv·키)이 게이트에 걸리지 않게 통째로 무시한다.
apps/navi_proto/
