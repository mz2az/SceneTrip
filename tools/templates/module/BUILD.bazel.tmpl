# {{PATH}} 의 타깃.
#
# AGENTS.md §4.1 의 이름 규칙을 따른다 — 라벨을 예측할 수 있어야 사람도 AI 도
# 이 파일을 먼저 읽지 않고 타깃을 조립할 수 있다.
#
#   :{{NAME}}           이 모듈의 주 라이브러리
#   :bin                실행 진입점
#   :unit_test          빠르고 격리됨          (tags = ["unit"])
#   :integration_test   외부 픽스처 필요        (tags = ["integration"])
#   :image              OCI 컨테이너 이미지
#   :push               레지스트리 푸시        (tags = ["manual"])
#
# 아래 자리표시자를 실제 {{LANG}} 규칙으로 바꾼 뒤 실행:
#   just gen && just build-module {{PATH}}

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "{{NAME}}",
    srcs = glob(
        ["src/**"],
        allow_empty = True,
    ),
)
