load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# 편의시설(POI) 적재 파일 준비 도구. 계획: docs/project/plans/poi-i18n-image.md §11.
py_library(
    name = "lib",
    srcs = [
        "addresses.py",
        "juso_api.py",
        "names.py",
        "pack.py",
    ],
    data = glob(["data/*.tsv"]),
)

# `just poi-en` — POI 적재 파일에 공식 영문 주소·영어 이름(확실할 때만)·로마자 읽기를 덧붙인다.
py_binary(
    name = "en",
    srcs = ["en.py"],
    main = "en.py",
    deps = [":lib"],
)

# `just poi-pack` — 한 판을 공유용으로 묶는다(src 를 빼고 gzip, manifest.json).
py_binary(
    name = "pack",
    srcs = ["pack.py"],
    main = "pack.py",
)

py_test(
    name = "unit_test",
    srcs = [
        "tests/test_addresses.py",
        "tests/test_juso_api.py",
        "tests/test_names_brands.py",
        "tests/test_names_final.py",
        "tests/test_names_regression.py",
        "tests/test_names_regression2.py",
        "tests/test_names_spec.py",
        "tests/test_pack.py",
        "tests/test_poi.py",
        "tests/test_spec.py",
    ],
    main = "tests/test_poi.py",
    tags = ["unit"],
    deps = [":lib"],
)
