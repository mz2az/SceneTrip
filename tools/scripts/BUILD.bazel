load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# iOS와 Android가 같은 영어 문구를 사용하도록 변환한다.
py_binary(
    name = "android_translations",
    srcs = ["android-translations.py"],
    legacy_create_init = 0,
    main = "android-translations.py",
    visibility = ["//visibility:public"],
)

# iOS 형식 지정자·이스케이프·중복 문구 변환 검증.
py_test(
    name = "android_translations_unit_test",
    srcs = ["test_android_translations.py"],
    data = ["android-translations.py"],
    legacy_create_init = 0,
    main = "test_android_translations.py",
    tags = ["unit"],
)

# 앱 데이터를 지우지 않는 iOS 설치와 실행 인자·오류 전달 검증.
py_test(
    name = "ios_run_unit_test",
    srcs = ["test_ios_run.py"],
    data = [
        "_lib.sh",
        "ios-run.sh",
    ],
    legacy_create_init = 0,
    main = "test_ios_run.py",
    tags = ["unit"],
)

# 큰 SQL 파일의 표준입력 전달과 로컬 DB 경계 검증.
py_test(
    name = "db_psql_file_unit_test",
    srcs = ["test_db_psql_file.py"],
    data = [
        "_lib.sh",
        "db-psql-file.sh",
    ],
    legacy_create_init = 0,
    main = "test_db_psql_file.py",
    tags = ["unit"],
)

# Java 포맷 검사에서 Bazel 진단과 실제 포맷 결과를 구분하는 회귀 시험.
py_test(
    name = "unit_test",
    srcs = ["test_format.py"],
    data = [
        "_lib.sh",
        "format.sh",
    ],
    legacy_create_init = 0,
    main = "test_format.py",
    tags = ["unit"],
)

# //platform/kubernetes:unit_test 가 로컬 스택이 MinIO 를 띄우는지 확인한다(review.md §14).
exports_files(
